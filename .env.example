# Copy this file to .env. Never commit the real .env file.
C5GO_HTTP_PORT=5063

MYSQL_DATABASE=c5go
MYSQL_USER=c5go_app
MYSQL_PASSWORD=replace-with-a-long-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-root-password

APP_BASE_URL=http://localhost:5063
APP_AUTH_URL=http://localhost:5063
APP_API_URL=http://localhost:5063
ALLOWED_HOSTS=localhost;127.0.0.1;[::1];c5g0.com;www.c5g0.com;auth.c5g0.com;api.c5g0.com

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER_NAME=C5GO Platform
EMAIL_SENDER_EMAIL=replace@example.com
EMAIL_USERNAME=replace@example.com
EMAIL_PASSWORD=replace-with-a-google-app-password

# Cloudflare public test keys. Replace them before public deployment.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional. Without this token, the application uses mock match data.
PANDA_SCORE_API_KEY=
COMMUNITY_ENABLED=true

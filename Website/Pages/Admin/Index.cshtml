@page
@using Microsoft.Extensions.Options
@using Website.Configuration
@inject IOptions<FeatureOptions> FeatureOptions
@model Website.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Administration";
    var dashboardRole = User.IsInRole("Owner") ? "Owner" : "Administrator";
}

<section class="admin-shell">
    <header class="admin-page-header admin-dashboard-header">
        <div>
            <p class="admin-eyebrow">C5GO control panel</p>
            <h1>Administration</h1>
            <p>Manage the website from one protected area.</p>
        </div>
        <div class="admin-access-summary" aria-label="Current administration access">
            <span>Signed in as</span>
            <strong>@dashboardRole</strong>
            <small>Protected workspace</small>
        </div>
    </header>

    <div class="admin-stat-grid" aria-label="Website statistics">
        <article class="admin-stat-card">
            <span>Users</span>
            <strong>@Model.UserCount</strong>
        </article>
        <article class="admin-stat-card">
            <span>Players</span>
            <strong>@Model.PlayerCount</strong>
        </article>
        <article class="admin-stat-card">
            <span>News</span>
            <strong>@Model.PostCount</strong>
        </article>
        <article class="admin-stat-card">
            <span>Tournaments</span>
            <strong>@Model.TournamentCount</strong>
        </article>
    </div>

    <div class="admin-action-grid">
        <a asp-page="/Admin/Users/Index" class="admin-action-card">
            <span class="admin-action-number">01</span>
            <h2>User management</h2>
            <p>Search accounts, review their status and manage player access.</p>
            <strong>Open users</strong>
        </a>

        <a asp-page="/Admin/Posts/Manage" class="admin-action-card">
            <span class="admin-action-number">02</span>
            <h2>News management</h2>
            <p>Create, update and remove announcements shown on the website.</p>
            <strong>Open news</strong>
        </a>

        <a asp-page="/Admin/Tournaments/Index" class="admin-action-card">
            <span class="admin-action-number">03</span>
            <h2>Tournament management</h2>
            <p>Create tournaments, manage participants, generate brackets and enter results.</p>
            <strong>Open tournaments</strong>
        </a>

        @if (FeatureOptions.Value.CommunityEnabled)
        {
            <a asp-page="/Moderation/Reports" class="admin-action-card">
                <span class="admin-action-number">04</span>
                <h2>Community moderation</h2>
                <p>Review reports and moderate discussions and comments.</p>
                <strong>Open reports</strong>
            </a>
        }
    </div>
</section>

@page
@model Website.Pages.Admin.Posts.CreateModel

<h2 class="mb-4 fw-bold">Create post</h2>

<form method="post" enctype="multipart/form-data" class="col-md-8">

    <div class="mb-3">
        <label class="form-label">Title</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Content</label>
        <textarea asp-for="PostContent"
                  class="form-control"
                  rows="8"
                  required></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Image (optional)</label>
        <input asp-for="Image" type="file" class="form-control" />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            Save
        </button>

        <a asp-page="Manage" class="btn btn-secondary">
            Cancel
        </a>
    </div>

</form>


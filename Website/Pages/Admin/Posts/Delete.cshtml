@page "{id:int}"
@model Website.Pages.Admin.Posts.DeleteModel
@{
    ViewData["Title"] = "Delete post";
}

<section class="admin-shell admin-form-shell">
    <nav class="admin-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Admin/Index">Administration</a><span>/</span><a asp-page="/Admin/Posts/Manage">Posts</a><span>/</span><span>Delete</span>
    </nav>

    <div class="admin-panel admin-form-card">
        <p class="admin-eyebrow">Permanent action</p>
        <h1 class="h2">Delete post</h1>
        <p class="text-secondary">This post and its public content will be permanently removed.</p>
        <div class="admin-inline-notice mb-3"><strong>@Model.Post.Title</strong></div>
        <form method="post" class="admin-form-actions">
            <button type="submit" class="btn btn-danger">Delete post</button>
            <a asp-page="/Admin/Posts/Manage" class="btn btn-outline-light">Cancel</a>
        </form>
    </div>
</section>

@page "{id:int}"
@model Website.Pages.Admin.Posts.DeleteModel

<h2 class="text-danger fw-bold mb-3">Delete post</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this post?
</div>

<div class="mb-4">
    <strong>@Model.Post.Title</strong>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">
        Yes, delete
    </button>

    <a asp-page="Manage" class="btn btn-secondary ms-2">
        Cancel
    </a>
</form>


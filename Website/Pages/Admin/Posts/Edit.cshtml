@page "{id:int}"
@model Website.Pages.Admin.Posts.EditModel
@{
    ViewData["Title"] = "Edit announcement";
}

<section class="admin-shell admin-form-shell">
    <nav class="admin-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Admin/Index">Administration</a><span>/</span><a asp-page="/Admin/Posts/Manage">News</a><span>/</span><span>Edit</span>
    </nav>

    <header class="admin-page-header">
        <p class="admin-eyebrow">Update content</p>
        <h1>Edit announcement</h1>
        <p>Update the announcement text or replace its cover image.</p>
    </header>

    <form method="post" enctype="multipart/form-data" class="admin-panel admin-form-card">
        <input type="hidden" asp-for="Post.Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Post.Title" class="form-label">Title</label>
            <input asp-for="Post.Title" class="form-control" maxlength="200" required />
        </div>
        <div class="mb-3">
            <label asp-for="Post.Content" class="form-label">Content</label>
            <textarea asp-for="Post.Content" class="form-control" rows="10" required></textarea>
        </div>

        @if (!string.IsNullOrEmpty(Model.Post.ImagePath))
        {
            <div class="mb-3">
                <span class="form-label d-block">Current image</span>
                <img src="@Model.Post.ImagePath" class="admin-current-image" alt="Current post cover" />
                <label class="form-check mt-2">
                    <input asp-for="RemoveImage" class="form-check-input" />
                    <span class="form-check-label">Remove the current image</span>
                </label>
            </div>
        }

        <div class="mb-3">
            <label asp-for="Image" class="form-label">Replace image (optional)</label>
            <input asp-for="Image" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" />
            <span class="form-text">JPEG, PNG or WebP, up to 5 MB.</span>
            <span asp-validation-for="Image" class="text-danger"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-page="/Admin/Posts/Manage" class="btn btn-outline-light">Cancel</a>
        </div>
    </form>
</section>

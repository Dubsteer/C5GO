@page
@model Website.Pages.Admin.Posts.ManageModel
@{
    ViewData["Title"] = "Post management";
}

<section class="admin-shell">
    <nav class="admin-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Admin/Index">Administration</a><span>/</span><span>Posts</span>
    </nav>

    <header class="admin-page-header admin-page-header-row">
        <div>
            <p class="admin-eyebrow">Website content</p>
            <h1>Post management</h1>
            <p>Create and maintain announcements shown on the home page.</p>
        </div>
        <a asp-page="/Admin/Posts/Create" class="btn btn-success">Create post</a>
    </header>

    @if (!Model.Posts.Any())
    {
        <div class="admin-empty-state"><h2>No posts yet</h2><p>Create the first announcement for the website.</p></div>
    }
    else
    {
        <div class="table-responsive admin-table-wrap">
            <table class="table admin-table align-middle">
                <thead><tr><th>Post</th><th>Author</th><th>Published</th><th>Image</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var post in Model.Posts)
                    {
                        <tr>
                            <td><strong>@post.Title</strong></td>
                            <td>@post.User.Username</td>
                            <td>@post.Posted_on.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(post.ImagePath))
                                {
                                    <img src="@post.ImagePath" class="admin-post-image" alt="" />
                                }
                                else
                                {
                                    <span class="admin-badge">No image</span>
                                }
                            </td>
                            <td>
                                <div class="admin-row-actions">
                                    <a asp-page="/Admin/Posts/Edit" asp-route-id="@post.Id" class="btn btn-sm btn-primary">Edit</a>
                                    <a asp-page="/Admin/Posts/Delete" asp-route-id="@post.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

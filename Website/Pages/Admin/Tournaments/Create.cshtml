@page
@model Website.Pages.Admin.Tournaments.CreateModel
@{
    ViewData["Title"] = "Create tournament";
}

<section class="admin-shell admin-form-shell">
    <nav class="admin-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Admin/Index">Administration</a>
        <span>/</span>
        <a asp-page="/Admin/Tournaments/Index">Tournaments</a>
        <span>/</span>
        <span>Create</span>
    </nav>

    <header class="admin-page-header">
        <p class="admin-eyebrow">New competition</p>
        <h1>Create tournament</h1>
        <p>The tournament starts open. Participants and brackets are managed after creation.</p>
    </header>

    <form method="post" class="admin-panel admin-form-card">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" maxlength="50" autocomplete="off" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="5" maxlength="300"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger"></span>
        </div>

        <div class="form-check admin-checkbox-card">
            <input asp-for="Input.IsTeamTournament" class="form-check-input" />
            <label asp-for="Input.IsTeamTournament" class="form-check-label"></label>
            <span>Team competitions use five-player teams. Solo competitions register individual players.</span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn btn-success">Create tournament</button>
            <a asp-page="/Admin/Tournaments/Index" class="btn btn-outline-light">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

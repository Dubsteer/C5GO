@page
@model Website.Pages.EditProfileModel
@{
    ViewData["Title"] = "Edit profile";
}

<h2 class="card-title">Register</h2>

<form method="post">
    <div class="form-group">
        <label>First name:</label>
        <br />
        <input asp-for="FullUserFormModel.Firstname">
        <span asp-validation-for="FullUserFormModel.Firstname"></span>
    </div>
    <div class="form-group">
        <label>Last name:</label>
        <br />
        <input asp-for="FullUserFormModel.Lastname">
        <span asp-validation-for="FullUserFormModel.Lastname"></span>
    </div>
    <div class="form-group">
        <label>Address:</label>
        <br />
        <input asp-for="FullUserFormModel.Age">
        <span asp-validation-for="FullUserFormModel.Age"></span>
    </div>
    <div class="form-group">
        <label>Username:</label>
        <br />
        <input asp-for="FullUserFormModel.Username">
        <span asp-validation-for="FullUserFormModel.Username"></span>
    </div>
    <div class="form-group">
        <label>Email:</label>
        <br />
        <input asp-for="FullUserFormModel.Gmail">
        <span asp-validation-for="FullUserFormModel.Gmail"></span>
    </div>
    <div class="form-group">
        <label>Password:</label>
        <br />
        <input type="password" asp-for="FullUserFormModel.Password">
        <span asp-validation-for="FullUserFormModel.Password"></span>
    </div>

    <br />
    <input type="submit" value="Edit profile" />
</form>

@section scripts{
    <partial name="_ValidationScriptsPartial" />
}
@page
@model Website.Pages.EditProfileModel
@{
    ViewData["Title"] = "Edit Profile";
    Layout = "_ProfileLayout";
}

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

<form method="post">
    <div class="mb-3">
        <span class="profile-label">First Name</span>
        <input asp-for="FullUserFormModel.Firstname" class="form-control" />
        <span asp-validation-for="FullUserFormModel.Firstname" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <span class="profile-label">Last Name</span>
        <input asp-for="FullUserFormModel.Lastname" class="form-control" />
        <span asp-validation-for="FullUserFormModel.Lastname" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <span class="profile-label">Age</span>
        <input asp-for="FullUserFormModel.Age" class="form-control" />
        <span asp-validation-for="FullUserFormModel.Age" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <span class="profile-label">Username</span>
        <input asp-for="FullUserFormModel.Username" class="form-control" />
        <span asp-validation-for="FullUserFormModel.Username" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <span class="profile-label">Email</span>
        <input asp-for="FullUserFormModel.Gmail" class="form-control" />
        <span asp-validation-for="FullUserFormModel.Gmail" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <span class="profile-label">New Password (optional)</span>
        <input type="password" asp-for="FullUserFormModel.Password" class="form-control" />
        <span asp-validation-for="FullUserFormModel.Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-main w-100 mt-3">Save Changes</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model Website.Pages.EditProfileModel
@{
    ViewData["Title"] = "Edit Profile";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<div class="container mt-5">
    <div class="card shadow p-4" style="max-width:700px; margin:auto;">
        <h2 class="mb-4 text-center">Edit Profile</h2>

        @if (ViewData["Error"] != null)
        {
            <div class="alert alert-danger">@ViewData["Error"]</div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label">First Name</label>
                <input asp-for="FullUserFormModel.Firstname" class="form-control" />
                <span asp-validation-for="FullUserFormModel.Firstname" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Last Name</label>
                <input asp-for="FullUserFormModel.Lastname" class="form-control" />
                <span asp-validation-for="FullUserFormModel.Lastname" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Age</label>
                <input asp-for="FullUserFormModel.Age" class="form-control" />
                <span asp-validation-for="FullUserFormModel.Age" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input asp-for="FullUserFormModel.Username" class="form-control" />
                <span asp-validation-for="FullUserFormModel.Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="FullUserFormModel.Gmail" class="form-control" />
                <span asp-validation-for="FullUserFormModel.Gmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">New Password (optional)</label>
                <input type="password" asp-for="FullUserFormModel.Password" class="form-control" placeholder="Leave empty to keep current password" />
                <span asp-validation-for="FullUserFormModel.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success w-100">Save Changes</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="error-page">
    <p class="error-code">500</p>
    <h1>Something went wrong</h1>
    <p>We could not complete your request. Try again or return to the home page.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary">Return home</a>
</section>

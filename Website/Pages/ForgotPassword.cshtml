@page
@model Website.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="auth-container" aria-labelledby="forgotPasswordTitle">
    <div class="auth-card">
        <h1 id="forgotPasswordTitle">Forgot password?</h1>
        <p class="auth-intro">Enter the email address connected to your account. We will send you a secure password reset link.</p>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="auth-field">
                <label asp-for="Form.Email">Email</label>
                <input asp-for="Form.Email" class="auth-input" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Form.Email" class="field-error"></span>
            </div>

            <button type="submit" class="auth-btn">Send reset link</button>
        </form>

        <p class="small-text">
            Remembered your password? <a asp-page="/Login">Back to login</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

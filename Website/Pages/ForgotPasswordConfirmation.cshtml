@page
@model Website.Pages.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}

<section class="status-container" aria-labelledby="forgotPasswordConfirmationTitle">
    <div class="status-card">
        <div class="status-icon status-icon-email" aria-hidden="true">&#9993;</div>
        <h1 id="forgotPasswordConfirmationTitle">Check your email</h1>
        <p>If an account exists for that address, we sent a password reset link. The link is valid for one hour.</p>
        <a asp-page="/Login" class="btn btn-primary">Back to login</a>
    </div>
</section>

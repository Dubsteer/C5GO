@page
@using LogicLayer.Models
@model IndexModel
@{
    ViewData["Title"] = "Posts";
}

<style>
    body {
        background-color: #0d1117;
        color: #f0f0f0;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    h1 {
        color: #ffffff;
        font-weight: 900;
        font-size: 36px;
        text-align: center;
        margin-bottom: 40px;
    }

    /* ===== CLICKABLE POST CARD (FULL CARD IS LINK) ===== */
    .post-link {
        text-decoration: none !important;
        color: inherit !important;
        display: block;
    }

    .post-card {
        background: #161b22;
        border-radius: 12px;
        padding: 22px;
        border: 1px solid #2d333b;
        transition: transform .20s ease, box-shadow .20s ease;
        min-height: 180px;
        cursor: pointer;
    }

        .post-card:hover {
            transform: scale(1.03);
            box-shadow: 0px 0px 10px rgba(99, 102, 241, 0.4);
            border-color: #6366f1;
        }

    .post-title {
        color: #ffffff;
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .post-snippet {
        color: #d0d0d0;
        font-size: 15px;
        margin-top: 10px;
    }
</style>

<div class="container mt-5">

    <h1> Announcements</h1>

    <div class="row g-4">

        @foreach (Post post in Model.Posts)
        {
            <div class="col-md-4">

                <!-- FULL CARD CLICKABLE LIKE TOURNAMENTS -->
                <a asp-page="/Posts/Post"
                   asp-route-id="@post.Id"
                   class="post-link">

                    <div class="post-card">

                        <div class="post-title">
                            @Model.TruncateString(post.Content, 45)
                        </div>

                        <p class="post-snippet">
                            @Model.TruncateString(post.Content, 110)
                        </p>

                    </div>

                </a>

            </div>
        }

    </div>

</div>

@page
@using LogicLayer.Models
@model IndexModel
@{
    ViewData["Title"] = "Posts";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<style>
    body {
        background-color: #121212;
    }

    .post-card {
        background: #1e1e1e;
        color: white;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #333;
        transition: 0.25s;
        min-height: 180px;
    }

        .post-card:hover {
            border-color: #7b4bff;
            transform: translateY(-3px);
        }

    a.post-link {
        color: #b38cff;
        text-decoration: none;
        font-size: 22px;
        font-weight: 600;
    }

        a.post-link:hover {
            text-decoration: underline;
        }

    .post-snippet {
        color: #aaa;
        margin-top: 12px;
        font-size: 16px;
    }

</style>

<div class="container mt-5">
    <h1 class="text-center mb-5 text-light">📝 Latest Posts</h1>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (Post post in Model.Posts)
        {
            <div class="col">
                <div class="post-card">
                    <a class="post-link" href="/posts?id=@post.Id">@Model.TruncateString(post.Content, 45)</a>
                    <p class="post-snippet">@Model.TruncateString(post.Content, 110)</p>
                </div>
            </div>
        }
    </div>
</div>

@page
@model IndexModel
@{
    ViewData["Title"] = "News";
    var orderedPosts = Model.Posts
        .OrderByDescending(post => post.Posted_on)
        .ThenByDescending(post => post.Id)
        .ToList();
}

<section class="news-page">
    <header class="news-hero">
        <div>
            <p class="news-eyebrow">C5GO newsroom</p>
            <h1>News &amp; Announcements</h1>
        </div>
        <p>Follow tournament updates, platform news and highlights from the Counter-Strike community.</p>
    </header>

    @if (orderedPosts.Count == 0)
    {
        <div class="page-empty-state">
            <strong>No news yet</strong>
            <span>New announcements will appear here.</span>
        </div>
    }
    else
    {
        var featuredPost = orderedPosts[0];
        var featuredTitle = string.IsNullOrWhiteSpace(featuredPost.Title)
            ? "C5GO update"
            : featuredPost.Title;

        <article class="news-feature">
            <a asp-page="/Posts/Post"
               asp-route-id="@featuredPost.Id"
               class="news-feature-card"
               aria-label="Open news: @featuredTitle">
                <div class="news-feature-media">
                    @if (!string.IsNullOrWhiteSpace(featuredPost.ImagePath))
                    {
                        <img src="@featuredPost.ImagePath" alt="" />
                    }
                    else
                    {
                        <div class="news-feature-placeholder" aria-hidden="true">
                            <span>C5GO</span>
                            <strong>NEWS</strong>
                        </div>
                    }
                </div>

                <div class="news-feature-content">
                    <div class="news-meta">
                        <span class="news-label">Featured</span>
                        <time datetime="@featuredPost.Posted_on.ToString("O")">
                            @featuredPost.Posted_on.ToString("dd MMM yyyy")
                        </time>
                    </div>
                    <h2>@Model.TruncateString(featuredTitle, 100)</h2>
                    <p>@Model.TruncateString(Model.GetPostPreview(featuredPost.Content), 260)</p>
                    <span class="news-card-arrow" aria-hidden="true">&rarr;</span>
                </div>
            </a>
        </article>

        @if (orderedPosts.Count > 1)
        {
            <div class="news-section-heading">
                <div>
                    <p class="news-eyebrow">News feed</p>
                    <h2>Latest news</h2>
                </div>
                <span class="news-count">@((orderedPosts.Count - 1).ToString()) updates</span>
            </div>

            <div class="news-grid">
                @foreach (var post in orderedPosts.Skip(1))
                {
                    var title = string.IsNullOrWhiteSpace(post.Title) ? "C5GO update" : post.Title;

                    <article>
                        <a asp-page="/Posts/Post"
                           asp-route-id="@post.Id"
                           class="news-card"
                           aria-label="Open news: @title">
                            @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                            {
                                <div class="news-card-media">
                                    <img src="@post.ImagePath" alt="" loading="lazy" />
                                </div>
                            }

                            <div class="news-card-content">
                                <time datetime="@post.Posted_on.ToString("O")">
                                    @post.Posted_on.ToString("dd MMM yyyy")
                                </time>
                                <h3>@Model.TruncateString(title, 70)</h3>
                                <p>@Model.TruncateString(Model.GetPostPreview(post.Content), 145)</p>
                                <span class="news-card-arrow" aria-hidden="true">&rarr;</span>
                            </div>
                        </a>
                    </article>
                }
            </div>
        }
    }
</section>

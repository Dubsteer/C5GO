@page
@using LogicLayer.Models;
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="row row-cols-3 row-cols-md g-4">
    @foreach (Post post in Model.Posts)
    {
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <a href="/posts?id=@post.Id">
                        <h5 class="card-title text-dark">@Model.TruncateString(post.Content, 50)</h5>
                    </a>
                    <hr>
                    <p class="text-dark"></p>
                </div>
            </div>
        </div>
    }
</div>
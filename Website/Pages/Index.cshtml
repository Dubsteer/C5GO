@page
@model IndexModel
@{
    ViewData["Title"] = "Posts";
    var orderedPosts = Model.Posts.OrderByDescending(post => post.Id).ToList();
}

<section class="posts-page">
    <header class="page-header page-header-centered">
        <h1 class="page-title">Announcements</h1>
        <p class="page-subtitle">News, tournament updates and community highlights.</p>
    </header>

    <h2 class="section-heading">Latest posts</h2>

    @if (orderedPosts.Count == 0)
    {
        <div class="page-empty-state">
            <strong>No posts yet</strong>
            <span>New announcements will appear here.</span>
        </div>
    }
    else
    {
        <div class="post-grid">
            @for (var index = 0; index < orderedPosts.Count; index++)
            {
                var post = orderedPosts[index];
                var isFeatured = index == 0;

                <article class="post-grid-item @(isFeatured ? "post-grid-item-featured" : string.Empty)">
                    <a asp-page="/Posts/Post" asp-route-id="@post.Id" class="post-link">
                        <div class="post-card @(isFeatured ? "featured" : string.Empty)">
                            @if (isFeatured)
                            {
                                <span class="featured-badge">Featured</span>
                            }
                            <h2 class="post-title">
                                @Model.TruncateString(post.Title ?? post.Content, isFeatured ? 80 : 45)
                            </h2>
                            <p class="post-snippet">
                                @Model.TruncateString(Model.GetPostPreview(post.Content), isFeatured ? 220 : 120)
                            </p>
                            <span class="read-more">Read post <span aria-hidden="true">&rarr;</span></span>
                        </div>
                    </a>
                </article>
            }
        </div>
    }
</section>

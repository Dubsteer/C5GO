@page
@using LogicLayer.Models
@model IndexModel
@{
    ViewData["Title"] = "Posts";
}

<style>
    body {
        background-color: #0d1117;
        color: #f0f0f0;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    h1 {
        color: #ffffff;
        font-weight: 900;
        font-size: 34px;
        text-align: center;
        margin-bottom: 35px;
    }

    /* FULL CARD LINK */
    .post-link {
        text-decoration: none !important;
        color: inherit !important;
        display: block;
        height: 100%;
    }

    .post-card {
        background: #161b22;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #2d333b;
        height: 100%;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .post-card:hover {
            border-color: #6366f1;
            box-shadow: 0 0 10px rgba(99,102,241,0.35);
        }

    .post-title {
        color: #ffffff;
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .post-snippet {
        color: #d1d5db;
        font-size: 14px;
        line-height: 1.5;
    }
</style>

<div class="container mt-4">

    <h1>Announcements</h1>

    <div class="row g-4">

        @foreach (Post post in Model.Posts)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <a asp-page="/Posts/Post"
                   asp-route-id="@post.Id"
                   class="post-link">

                    <div class="post-card">

                        <div class="post-title">
                            @Model.TruncateString(post.Title ?? post.Content, 45)
                        </div>

                        <div class="post-snippet">
                            @Model.TruncateString(post.Content, 110)
                        </div>

                    </div>
                </a>
            </div>
        }

    </div>

</div>

@page
@model Website.Pages.LoginModel
@{
    ViewData["Title"] = "Log in";
}


<style>
    .centered-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .card {
        max-width: 400px;
        padding: 20px;
    }
</style>

<div class="centered-container">
    <div class="card">
        

        <h2 class="card-title">Log In</h2>
        <form method="post">
            <div class="form-group">
                <label>Username:</label>
                <br />
                <input asp-for="LoginFormModel.Username">
                <span asp-validation-for="LoginFormModel.Username"></span>
            </div>
            <div class="form-group">
                <label>Password:</label>
                <br />
                <input type="password" asp-for="LoginFormModel.Password">
                <span asp-validation-for="LoginFormModel.Password"></span>
            </div>

            <br />
            <small class="form-text text-muted">Don't have an account? <a href="/Register">Register</a></small>
            <br />
            <input type="submit" value="Log In" />
        </form>

        <section scripts>
            <partial name="_ValidationScriptsPartial" />
        </section>
    </div>
</div>
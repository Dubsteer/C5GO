@page
@model Website.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-container" aria-labelledby="loginTitle">
    <div class="auth-card">
        <h1 id="loginTitle">Log in</h1>

        @if (ViewData["Error"] is string errorMessage)
        {
            <div class="auth-error" role="alert">@errorMessage</div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="auth-field">
                <label asp-for="LoginFormModel.Username">Username</label>
                <input asp-for="LoginFormModel.Username" class="auth-input" autocomplete="username" />
                <span asp-validation-for="LoginFormModel.Username" class="field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="LoginFormModel.Password">Password</label>
                <input asp-for="LoginFormModel.Password" class="auth-input" type="password" autocomplete="current-password" />
                <span asp-validation-for="LoginFormModel.Password" class="field-error"></span>
            </div>

            <div class="auth-help-link">
                <a asp-page="/ForgotPassword">Forgot password?</a>
            </div>

            <button type="submit" class="auth-btn">Log in</button>
        </form>

        <p class="small-text">
            Don't have an account? <a asp-page="/Register">Register</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model Website.Pages.Matches.DetailsModel
@{
    ViewData["Title"] = "Match details";
}

<section class="details-container">
    <div class="details-heading-row">
        <a asp-page="/Matches/Index" class="back-link">&larr; Back to matches</a>
        <h1>Match details</h1>
    </div>

    @if (Model.Match == null)
    {
        <div class="empty-state"><strong>Match not found</strong><span>The match may no longer be available.</span></div>
    }
    else
    {
        var matchHeaderClass = Model.Match.Status == "Live" ? "match-header-live" : "match-header-upcoming";

        <header class="match-header @matchHeaderClass">
            <div class="teams">
                <div class="team-side">
                    <img class="team-logo" src="@(string.IsNullOrEmpty(Model.Match.Team1LogoUrl) ? "/Images/default-team.svg" : Model.Match.Team1LogoUrl)"
                         onerror="this.onerror=null;this.src='/Images/default-team.svg';" alt="" />
                    <span class="team-name">@Model.Match.Team1Name</span>
                </div>
                <div class="score">@(string.IsNullOrEmpty(Model.Match.Score) ? "-" : Model.Match.Score)</div>
                <div class="team-side right">
                    <span class="team-name">@Model.Match.Team2Name</span>
                    <img class="team-logo" src="@(string.IsNullOrEmpty(Model.Match.Team2LogoUrl) ? "/Images/default-team.svg" : Model.Match.Team2LogoUrl)"
                         onerror="this.onerror=null;this.src='/Images/default-team.svg';" alt="" />
                </div>
            </div>

            <div class="event">@Model.Match.EventName</div>
            <div class="match-info">
                @if (!string.IsNullOrWhiteSpace(Model.Match.Format))
                {
                    <span class="info-pill">@Model.Match.Format</span>
                }
                @if (Model.Match.Status == "Live")
                {
                    <span class="live-badge">Live</span>
                }
                else if (Model.Match.Status == "Upcoming")
                {
                    <span class="upcoming-badge">@(Model.Match.StartTimeUtc.HasValue ? Model.Match.StartTimeUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Time TBD")</span>
                }
                else
                {
                    <span class="finished-badge">Finished</span>
                }
            </div>
        </header>

        <section class="match-section" aria-labelledby="mapsTitle">
            <h2 id="mapsTitle">Maps</h2>
            @if (Model.Match.Maps.Any())
            {
                foreach (var map in Model.Match.Maps)
                {
                    <div class="map-row"><span>@map.MapName</span><strong>@map.Score</strong></div>
                }
            }
            else
            {
                <div class="empty-state"><strong>Map details unavailable</strong><span>The current PandaScore plan does not provide individual map data.</span></div>
            }
        </section>

        <section class="match-section" aria-labelledby="watchTitle">
            <h2 id="watchTitle">Watch</h2>
            @if (Model.Match.Streams.Any())
            {
                foreach (var stream in Model.Match.Streams)
                {
                    <div class="stream">
                        <div><strong>@stream.StreamerName</strong> <span class="stream-platform">@stream.Platform</span></div>
                        <div class="stream-actions">
                            @if (stream.Viewers > 0)
                            {
                                <span class="viewer-count">@stream.Viewers viewers</span>
                            }
                            <a href="@stream.Url" target="_blank" rel="noopener noreferrer" class="watch-btn">Watch stream</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><strong>No stream available</strong><span>An official stream may appear closer to the match start.</span></div>
            }
        </section>
    }
</section>

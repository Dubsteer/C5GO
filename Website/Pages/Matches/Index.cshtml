@page
@model Website.Pages.Matches.IndexModel
@{
    ViewData["Title"] = "Matches";
}

<section class="matches-container" aria-labelledby="matchesTitle">
    <header class="page-header history-page-header">
        <div>
            <h1 id="matchesTitle" class="matches-title">Live &amp; upcoming matches</h1>
            <p class="page-subtitle ms-0">Professional Counter-Strike matches provided by PandaScore.</p>
        </div>
        <nav class="matches-view-switch" aria-label="Match views">
            <span aria-current="page">Live &amp; upcoming</span>
            <a asp-page="/Matches/History">History</a>
        </nav>
    </header>

    @if (!Model.Matches.Any())
    {
        <div class="empty-state"><strong>No matches available</strong><span>Check again later for live and upcoming matches.</span></div>
    }
    else
    {
        foreach (var match in Model.Matches)
        {
            var matchCardClass = match.Status == "Live" ? "match-card-live" : match.Status == "Upcoming" ? "match-card-upcoming" : "match-card-finished";

            <a asp-page="/Matches/Details" asp-route-id="@match.Id" class="match-card @matchCardClass">
                <div class="teams">
                    <div class="team-box">
                        <img class="team-logo" src="@(string.IsNullOrEmpty(match.Team1LogoUrl) ? "/Images/default-team.svg" : match.Team1LogoUrl)"
                             data-fallback-image="/Images/default-team.svg" alt="" />
                        <span class="team">@match.Team1Name</span>
                    </div>
                    <div class="score">@(string.IsNullOrEmpty(match.Score) ? "-" : match.Score)</div>
                    <div class="team-box right">
                        <span class="team">@match.Team2Name</span>
                        <img class="team-logo" src="@(string.IsNullOrEmpty(match.Team2LogoUrl) ? "/Images/default-team.svg" : match.Team2LogoUrl)"
                             data-fallback-image="/Images/default-team.svg" alt="" />
                    </div>
                </div>

                <div class="match-meta">
                    <span>@match.EventName</span>
                    @if (match.Status == "Live")
                    {
                        <span class="badge-live">Live</span>
                    }
                    else if (match.Status == "Upcoming")
                    {
                        <span class="badge-upcoming">@(match.StartTimeUtc.HasValue ? match.StartTimeUtc.Value.ToLocalTime().ToString("HH:mm") : "TBD")</span>
                    }
                    else
                    {
                        <span class="badge-finished">Finished</span>
                    }
                </div>
            </a>
        }
    }
</section>

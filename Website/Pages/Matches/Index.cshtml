@page
@model Website.Pages.Matches.IndexModel

@{
    ViewData["Title"] = "Matches";
}

<style>
    .matches-container {
        max-width: 900px;
        margin: auto;
    }

    .matches-title {
        margin-bottom: 20px;
        color: #f2f5f8;
        font-weight: 600;
    }

    .match-card {
        background: #161b22;
        border: 1px solid #2d333b;
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 12px;
        color: #d8dee7;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
    }

        .match-card:hover {
            transform: scale(1.01);
        }

    .match-card-live {
        background: linear-gradient(100deg, rgba(255, 59, 72, 0.13), #191d24 38%);
        border-color: rgba(255, 77, 87, 0.65);
        box-shadow: 0 0 16px rgba(255, 59, 72, 0.09);
    }

        .match-card-live:hover {
            border-color: #ff4d57;
            box-shadow: 0 0 20px rgba(255, 59, 72, 0.22);
        }

        .match-card-live .team,
        .match-card-live .score {
            color: #ffffff;
        }

        .match-card-live .match-meta {
            color: #c9d0d9;
        }

    .match-card-upcoming {
        background: #15191f;
        border-color: #343a43;
    }

        .match-card-upcoming:hover {
            border-color: #59616c;
            box-shadow: 0 0 14px rgba(145, 157, 171, 0.13);
        }

        .match-card-upcoming .team {
            color: #c2c8d0;
        }

        .match-card-upcoming .score {
            color: #9ba3ad;
        }

        .match-card-upcoming .team-logo {
            filter: grayscale(35%);
            opacity: 0.82;
        }

    .match-card-finished {
        background: #14181d;
        border-color: #30363d;
    }

        .match-card-finished .team,
        .match-card-finished .score {
            color: #9ca4ae;
        }

    .teams {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .team-box {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 35%;
    }

        .team-box.right {
            justify-content: flex-end;
        }

    .team {
        font-weight: 600;
        font-size: 15px;
        color: #e6ebf1;
    }

    .team-logo {
        width: 28px;
        height: 28px;
        object-fit: contain;
    }

    .score {
        font-weight: bold;
        font-size: 18px;
        width: 30%;
        text-align: center;
        color: #f0f3f6;
    }

    .match-meta {
        display: flex;
        justify-content: space-between;
        margin-top: 6px;
        font-size: 13px;
        color: #aeb6c1;
    }

    .badge-live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 8px;
        color: #ff6570;
        background: rgba(255, 59, 72, 0.12);
        border: 1px solid rgba(255, 77, 87, 0.38);
        border-radius: 999px;
        font-weight: bold;
        letter-spacing: 0.04em;
    }

        .badge-live::before {
            content: "";
            width: 7px;
            height: 7px;
            background: #ff3b48;
            border-radius: 50%;
            box-shadow: 0 0 8px rgba(255, 59, 72, 0.9);
    }

    .badge-upcoming {
        display: inline-block;
        padding: 3px 8px;
        color: #a9b4c0;
        background: rgba(139, 148, 158, 0.1);
        border: 1px solid rgba(139, 148, 158, 0.25);
        border-radius: 999px;
        font-weight: bold;
    }

    .badge-finished {
        color: #8b949e;
        font-weight: bold;
    }
</style>

<div class="matches-container">
    <h2 class="matches-title">Live &amp; Upcoming Matches</h2>

    @foreach (var match in Model.Matches)
    {
        var matchCardClass = match.Status == "Live"
            ? "match-card-live"
            : match.Status == "Upcoming"
                ? "match-card-upcoming"
                : "match-card-finished";

        <div class="match-card @matchCardClass"
             onclick="window.location='/Matches/Details?id=@match.Id'">

            <div class="teams">

                <!-- TEAM 1 -->
                <div class="team-box">
                    <img class="team-logo"
                         src="@(string.IsNullOrEmpty(match.Team1LogoUrl) ? "/Images/default-team.svg" : match.Team1LogoUrl)"
                         onerror="this.onerror=null;this.src='/Images/default-team.svg';"
                         alt="@match.Team1Name logo" />
                    <span class="team">@match.Team1Name</span>
                </div>

                <!-- SCORE -->
                <div class="score">
                    @(string.IsNullOrEmpty(match.Score) ? "-" : match.Score)
                </div>

                <!-- TEAM 2 -->
                <div class="team-box right">
                    <span class="team">@match.Team2Name</span>
                    <img class="team-logo"
                         src="@(string.IsNullOrEmpty(match.Team2LogoUrl) ? "/Images/default-team.svg" : match.Team2LogoUrl)"
                         onerror="this.onerror=null;this.src='/Images/default-team.svg';"
                         alt="@match.Team2Name logo" />
                </div>

            </div>

            <div class="match-meta">
                <div>@match.EventName</div>

                <div>
                    @if (match.Status == "Live")
                    {
                        <span class="badge-live">LIVE</span>
                    }
                    else if (match.Status == "Upcoming")
                    {
                        <span class="badge-upcoming">
                            @(match.StartTimeUtc.HasValue
                                                ? match.StartTimeUtc.Value.ToLocalTime().ToString("HH:mm")
                                                : "TBD")
                </span>
                                }
                    else
                    {
                        <span class="badge-finished">Finished</span>
                    }
                </div>
            </div>

        </div>
    }
</div>

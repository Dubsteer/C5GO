@page
@model Website.Pages.Moderation.ReportsModel
@using LogicLayer.Enums
@{
    ViewData["Title"] = "Community reports";
}

<section class="admin-shell">
    <nav class="admin-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Community/Index">Community</a><span>/</span><span>Reports</span>
    </nav>
    <header class="admin-page-header">
        <p class="admin-eyebrow">Moderation queue</p>
        <h1>Community reports</h1>
        <p>Review user reports and record the result of every decision.</p>
    </header>

    @if (TempData["CommunityMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    @if (TempData["CommunityError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (Model.Reports.Count == 0)
    {
        <div class="admin-panel community-empty">
            <h2>No pending reports</h2>
            <p>The moderation queue is clear.</p>
        </div>
    }
    else
    {
        <div class="moderation-report-list">
            @foreach (var report in Model.Reports)
            {
                <article class="admin-panel moderation-report-card">
                    <div class="moderation-report-header">
                        <div>
                            <span class="discussion-category-label">@report.Reason</span>
                            <h2>@report.TargetTitle</h2>
                        </div>
                        <time datetime="@report.CreatedAt.ToString("O")">@report.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</time>
                    </div>
                    <p>Reported by <strong>@report.ReporterUsername</strong></p>
                    @if (!string.IsNullOrWhiteSpace(report.TargetPreview))
                    {
                        <blockquote>@report.TargetPreview</blockquote>
                    }
                    @if (!string.IsNullOrWhiteSpace(report.Details))
                    {
                        <p><strong>Details:</strong> @report.Details</p>
                    }
                    <a asp-page="/Community/Details"
                       asp-route-id="@(report.DiscussionId ?? 0)"
                       asp-fragment="@(report.CommentId.HasValue ? $"comment-{report.CommentId}" : null)">Open content</a>
                    <form method="post" asp-page-handler="Review" class="moderation-review-form">
                        <input name="reportId" type="hidden" value="@report.Id" />
                        <input name="resolutionNote" class="form-control" maxlength="500" placeholder="Decision note (optional)" />
                        <button type="submit" name="status" value="@ReportStatus.Resolved" class="btn btn-success">Resolve</button>
                        <button type="submit" name="status" value="@ReportStatus.Rejected" class="btn btn-outline-light">Reject</button>
                    </form>
                </article>
            }
        </div>
    }
</section>

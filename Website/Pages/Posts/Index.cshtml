@page
@using LogicLayer.Models
@model Website.Pages.Posts.IndexModel
@{
    ViewData["Title"] = Model.post.Content;
}

<div>
    <h3 style="color: #fff; text-align: justify; font-size: 23px; margin-bottom: 20px;">
        @Model.post.Content
    </h3>

    @if (User.Identity.IsAuthenticated)
    {
        <form method="post" asp-page-handler="SubmitComment" style="margin-top: 20px;">
            <div style="display: flex; align-items: center;">
                <textarea asp-for="NewComment.CommentText" rows="4" cols="128" style="background-color: #ccc; padding: 10px; border-radius: 10px"></textarea>
                <input type="submit" value="Submit comment" style="margin-left: 10px;">
                <input asp-for="NewComment.commentPostId" type="hidden" value="@Model.post.Id" />
            </div>
            <br />
            <span asp-validation-for="NewComment.CommentText"></span>
        </form>
    }

    @if(Model.comments != null && Model.comments.Count > 0)
    {
        <h2 style="color: white; text-align: left;">Comments:</h2>
    }
    else
    {
        <h3 style="color: white; text-align: center;">No comments</h3>
    }

    @foreach (var com in Model.comments)
    {
        <div style="display: flex; flex-direction: column; align-items: center; margin-bottom: 10px;">
            <div style="display: flex; width: 100%; flex-direction: row">
            <h1 style="color: black; font-size: 17px; border: 1px solid #000; padding: 7px; padding-left: 10px; padding-right: 10px; border-radius: 13px; background-color: #ccc; flex-grow: 1; margin-bottom: 20px">@com.Content</h1>
            @if (User.Identity.IsAuthenticated)
            {
                if (Model.currentUser != null && (Model.currentUser.Id == com.User.Id || Model.currentUser.IsAdmin))
                {
                    <form method="post" asp-page-handler="DeleteComment" asp-route-id="@com.Id" style="margin-left: 10px;">
                        <input type="submit" value="Delete" style="font-size: 12px;">
                    </form>
                }
                <form method="post" asp-page-handler="SubmitReply" style="margin-left: 10px;">
                    <input type="hidden" value="@com.Id" asp-for="NewReply.replyCommentId" />
                    <input asp-for="NewReply.ReplyText" type="text" style="padding: 2px; border-radius: 10px" placeholder="Write a reply..." />
                    <input type="submit" value="Submit" />
                    <br />
                    <span asp-validation-for="NewReply.ReplyText"></span>
                </form>
            }
            </div>
            <div style="display: flex; flex-direction: column">
            @foreach (var r in com.Replies)
            {
                <div style="margin-left: -30vw">
                        <p style="color: black; font-size: 17px; border: 1px solid #000; padding-top: 3px; padding-bottom: 3px; padding-left: 5px; padding-right: 5px; border-radius: 13px; background-color: #ccc; flex-grow: 1; text-align: left; ">@r.Content</p>
                </div>
            }
            </div>
        </div>
    }
    <div style="height: 80px; width: 2px"></div>
</div>

@section scripts{
    <partial name="_ValidationScriptsPartial" />
}
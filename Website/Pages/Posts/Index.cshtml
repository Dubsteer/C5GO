@page
@using LogicLayer.Models
@model Website.Pages.Posts.IndexModel
@{
    ViewData["Title"] = Model.post.Content;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    body {
        background: #0f0f0f;
        color: white;
    }

    .post-container {
        max-width: 900px;
        margin: 50px auto;
        padding: 35px;
        background: #1c1c1c;
        border-radius: 14px;
        box-shadow: 0 0 20px rgba(0,0,0,0.5);
    }

    .comment-box {
        background: #2b2b2b;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .reply-box {
        background: #232323;
        border-left: 4px solid #6f42c1;
        padding: 10px 15px;
        margin-left: 20px;
        border-radius: 8px;
    }

    .comment-author {
        font-weight: bold;
        color: #c59dff;
    }

    .comment-text {
        color: #e0e0e0;
        margin-top: 3px;
        margin-bottom: 10px;
    }

    .reply-author {
        color: #b889ff;
        font-weight: bold;
    }

    .reply-text {
        color: #d8d8d8;
    }

    h1.title {
        text-align: center;
        margin-bottom: 30px;
        color: #d7b4ff;
        font-weight: 600;
    }

</style>

<div class="post-container">

    <h1 class="title">@Model.post.Content</h1>

    @* COMMENT FORM *@
    @if (User.Identity.IsAuthenticated)
    {
        <form method="post" asp-page-handler="SubmitComment">
            <textarea asp-for="NewComment.CommentText" class="form-control mb-3" rows="3" placeholder="Write a comment..."></textarea>
            <input type="hidden" asp-for="NewComment.commentPostId" value="@Model.post.Id" />
            <button class="btn btn-primary">Submit Comment</button>
        </form>
    }

    <hr class="my-4" />

    <h3 style="color: #d7b4ff;">💬 Comments</h3>

    @if (Model.comments == null || Model.comments.Count == 0)
    {
        <p class="text-muted">No comments yet.</p>
    }

    @foreach (var com in Model.comments)
    {
        <div class="comment-box">

            <span class="comment-author">@com.User.Username</span>
            <div class="comment-text">@com.Content</div>

            @* DELETE COMMENT *@
            @if (Model.currentUser != null && (Model.currentUser.Id == com.User.Id || Model.currentUser.IsAdmin))
            {
                <form method="post" asp-page-handler="DeleteComment" asp-route-id="@com.Id" style="display:inline;">
                    <button class="btn btn-sm btn-danger">Delete</button>
                </form>
            }

            @* REPLY FORM *@
            @if (User.Identity.IsAuthenticated)
            {
                <form method="post" asp-page-handler="SubmitReply" class="mt-3">
                    <input type="hidden" asp-for="NewReply.replyCommentId" value="@com.Id" />
                    <input asp-for="NewReply.ReplyText" class="form-control mb-2" placeholder="Write a reply..." />
                    <button class="btn btn-secondary btn-sm">Reply</button>
                </form>
            }

            @* REPLIES *@
            @foreach (var r in com.Replies)
            {
                <div class="reply-box mt-2">
                    <div class="reply-author">@r.AuthorUsername</div>
                    <div class="reply-text">@r.Content</div>
                </div>
            }
        </div>
    }
</div>

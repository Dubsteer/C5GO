@page "{id:int}"
@model Website.Pages.Posts.PostModel

<style>
    body {
        background-color: #0d1117;
        color: #f0f0f0;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    .post-wrapper {
        background: #161b22;
        border-radius: 12px;
        padding: 36px;
        max-width: 900px;
        margin: 40px auto;
        border: 1px solid #2d333b;
    }

    .post-image {
        width: 100%;
        max-height: 420px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 28px;
        border: 1px solid #2d333b;
    }

    .thread-header {
        padding-bottom: 28px;
        margin-bottom: 32px;
        border-bottom: 1px solid #2d333b;
    }

    .thread-title {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .thread-content {
        font-size: 17px;
        line-height: 1.75;
    }
</style>

<div class="post-wrapper">

    @if (!string.IsNullOrEmpty(Model.Post.ImagePath))
    {
        <img src="@Model.Post.ImagePath"
             class="post-image"
             alt="Post image" />
    }

    <div class="thread-header">
        <div class="thread-title">@Model.Post.Title</div>

        <!-- 🔥 OVO JE KLJUČ -->
        <div class="thread-content" id="postContent">
            @Html.Raw(Model.Post.Content)
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const container = document.getElementById("postContent");
            if (!container) return;

            let html = container.innerHTML;

            const ytRegex = /https?:\/\/(www\.)?youtube\.com\/watch\?v=([a-zA-Z0-9_-]+)/g;

            html = html.replace(ytRegex, function (_, __, videoId) {
                return `
                    <div style="margin:20px 0; display:flex; justify-content:center;">
                        <iframe width="560"
                                height="315"
                                src="https://www.youtube.com/embed/${videoId}"
                                frameborder="0"
                                allowfullscreen>
                        </iframe>
                    </div>
                `;
            });

            container.innerHTML = html;
        });
    </script>
}

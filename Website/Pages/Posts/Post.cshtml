@page "{id:int}"
@model Website.Pages.Posts.PostModel

@{
    ViewData["Title"] = "Post";
}

<style>
    body {
        background: #202225;
    }

    .post-container {
        background: #2f3136;
        padding: 25px;
        border-radius: 12px;
        max-width: 850px;
        margin: 20px auto;
        color: #fff;
    }

    .comment-container {
        background: #2f3136;
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 15px;
        color: #ddd;
    }

    .comment-header {
        font-weight: bold;
        font-size: 15px;
    }

    .comment-time {
        font-size: 12px;
        color: #aaa;
        margin-left: 5px;
    }

    .reply-container {
        background: #36393f;
        border-radius: 8px;
        padding: 10px;
        margin-left: 35px;
        margin-top: 8px;
        color: #ccc;
    }

    .show-btn, .reply-btn {
        background: none;
        border: none;
        color: #58a6ff;
        cursor: pointer;
        font-size: 14px;
        padding: 0;
        margin-top: 10px;
    }

    .delete-btn {
        background: none;
        border: none;
        color: #ff5555;
        font-size: 12px;
        margin-left: 15px;
        cursor: pointer;
    }
</style>

<div class="post-container">

    <h1 style="text-align:center;">@Model.Post.Content</h1>

    <hr style="border-color:#444;" />

    @if (User.Identity.IsAuthenticated)
    {
        <form method="post" asp-page-handler="SubmitComment">
            <textarea asp-for="NewComment.CommentText" rows="3" class="form-control"></textarea>
            <button type="submit" class="btn btn-primary mt-2">Send</button>
        </form>
    }

    <br />

    @if (Model.Comments.Count > 0)
    {
        <form method="post" asp-page-handler="ToggleComments">
            <button class="show-btn">
                @(Model.ShowAllComments ? "Hide comments" : $"Show all ({Model.Comments.Count})")
            </button>
        </form>
    }

    @{
        var shown = Model.ShowAllComments ? Model.Comments : Model.Comments.Take(3).ToList();
    }

    <br />

    @foreach (var com in shown)
    {
        <div class="comment-container">

            <div class="comment-header">
                @com.User.Username
                <span class="comment-time">@com.Posted_on.ToString("MMM dd, HH:mm")</span>

                @if (Model.CurrentUser != null &&
                    (Model.CurrentUser.Id == com.User.Id || Model.CurrentUser.IsAdmin))
                {
                    <form method="post" asp-page-handler="DeleteComment" asp-route-cid="@com.Id" style="display:inline;">
                        <button class="delete-btn">Delete</button>
                    </form>
                }
            </div>

            <div style="margin-top:6px;">@com.Content</div>

            <form method="post" asp-page-handler="ToggleReplies" asp-route-commentId="@com.Id">
                <button class="reply-btn">
                    @(Model.ExpandedReplies.Contains(com.Id)
                        ? "🔼 Hide replies"
                        : $"🔽 Show replies ({com.Replies.Count})")
                </button>
            </form>

            @if (Model.ExpandedReplies.Contains(com.Id))
            {
                foreach (var r in com.Replies)
                {
                    <div class="reply-container">
                        <strong>@r.Username</strong>
                        <span class="comment-time">@r.PostedOn.ToString("MMM dd, HH:mm")</span>
                        <div>@r.Content</div>
                    </div>
                }

                @if (User.Identity.IsAuthenticated)
                {
                    <form method="post" asp-page-handler="SubmitReply" style="margin-left:35px; margin-top:10px;">
                        <input asp-for="NewReply.replyCommentId" type="hidden" value="@com.Id" />
                        <input asp-for="NewReply.ReplyText" type="text" class="form-control" placeholder="Reply..." />
                        <button type="submit" class="btn btn-secondary btn-sm mt-2">Reply</button>
                    </form>
                }
            }
        </div>
    }
</div>

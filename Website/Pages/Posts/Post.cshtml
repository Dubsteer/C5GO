@page "{id:int}"
@model Website.Pages.Posts.PostModel
@{
    ViewData["Title"] = Model.Post.Title;
    var postAuthor = string.IsNullOrWhiteSpace(Model.Post.User.Username)
        ? "C5GO team"
        : Model.Post.User.Username;
}

<article class="post-wrapper">
    <a asp-page="/Index" class="post-back-link"><span aria-hidden="true">&larr;</span> Back to News</a>

    <header class="thread-header">
        <div class="post-meta">
            <span class="post-category">News</span>
            <time datetime="@Model.Post.Posted_on.ToString("O")">
                @Model.Post.Posted_on.ToString("dd MMM yyyy")
            </time>
            <span aria-hidden="true">&bull;</span>
            <a asp-page="/UserProfile" asp-route-id="@Model.Post.User.Id">@postAuthor</a>
        </div>
        <h1 class="thread-title">@Model.Post.Title</h1>
    </header>

    @if (!string.IsNullOrEmpty(Model.Post.ImagePath))
    {
        <img src="@Model.Post.ImagePath" class="post-image" alt="" />
    }

    <div class="thread-content" id="postContent">
        @foreach (var block in Model.ContentBlocks)
        {
            if (block.IsVideo)
            {
                <div class="video-embed">
                    <iframe src="https://www.youtube-nocookie.com/embed/@block.VideoId"
                            title="Video included in @Model.Post.Title"
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen></iframe>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(block.Text))
            {
                <div class="post-content-text">@block.Text</div>
            }
        }
    </div>

    <section class="comment-section" aria-labelledby="commentsTitle" data-comment-section>
        <div class="comment-section-header">
            <div>
                <p class="comment-section-eyebrow">Discussion</p>
                <h2 id="commentsTitle" class="section-heading">Comments</h2>
            </div>
            <span class="comment-count">@Model.Comments.Count</span>
        </div>

        <div class="comment-status" data-comment-status role="status" aria-live="polite" hidden></div>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post"
                  asp-page-handler="SubmitComment"
                  class="comment-compose"
                  data-async-comment-form
                  data-focus-after="comment-input"
                  data-success-message="Comment posted.">
                <div class="comment-compose-heading">
                    <span class="comment-avatar" aria-hidden="true">
                        @(string.IsNullOrWhiteSpace(Model.CurrentUser?.Username) ? "?" : Model.CurrentUser.Username[..1].ToUpperInvariant())
                    </span>
                    <div>
                        <strong>Join the conversation</strong>
                        <span>Share your thoughts with the community.</span>
                    </div>
                </div>
                <label asp-for="NewComment.CommentText" class="visually-hidden">Write a comment</label>
                <textarea asp-for="NewComment.CommentText"
                          class="form-control"
                          rows="3"
                          maxlength="@LogicLayer.Managers.CommentManager.MaxContentLength"
                          placeholder="Write a comment..."
                          data-comment-focus="comment-input"
                          required></textarea>
                <div class="comment-compose-footer">
                    <span>Maximum @LogicLayer.Managers.CommentManager.MaxContentLength characters</span>
                    <button type="submit" class="btn btn-primary">Post comment</button>
                </div>
            </form>
        }
        else
        {
            <p class="comment-login-note"><a asp-page="/Login">Log in</a> to write a comment.</p>
        }

        <hr class="thread-divider" />

        @await Html.PartialAsync("_CommentList", Model.CreateCommentsViewModel())
    </section>
</article>

@section Scripts {
    <script src="~/js/post.js" asp-append-version="true"></script>
}

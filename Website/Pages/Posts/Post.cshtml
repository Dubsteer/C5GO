@page "{id:int}"
@model Website.Pages.Posts.PostModel

<article class="post-wrapper">
    @if (!string.IsNullOrEmpty(Model.Post.ImagePath))
    {
        <img src="@Model.Post.ImagePath" class="post-image" alt="" />
    }

    <header class="thread-header">
        <h1 class="thread-title">@Model.Post.Title</h1>
        <div class="thread-content" id="postContent">@Html.Raw(Model.Post.Content)</div>
    </header>

    <section aria-labelledby="commentsTitle">
        <h2 id="commentsTitle" class="section-heading">Comments</h2>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-page-handler="SubmitComment">
                <label asp-for="NewComment.CommentText" class="visually-hidden">Write a comment</label>
                <textarea asp-for="NewComment.CommentText" class="form-control" rows="3" placeholder="Write a comment..." required></textarea>
                <button type="submit" class="btn btn-primary mt-2">Post comment</button>
            </form>
        }
        else
        {
            <p class="comment-login-note"><a asp-page="/Login">Log in</a> to write a comment.</p>
        }

        <hr class="thread-divider" />

        @if (!Model.Comments.Any())
        {
            <div class="empty-state">
                <strong>No comments yet</strong>
                <span>Start the conversation.</span>
            </div>
        }
        else
        {
            <div class="comment-list">
                @foreach (var comment in Model.Comments)
                {
                    <article class="comment-card">
                        <strong class="comment-author">@comment.User.Username</strong>
                        <p class="comment-content">@comment.Content</p>

                        @if (Model.CurrentUser != null && (Model.CurrentUser.IsAdmin || Model.CurrentUser.Id == comment.User.Id))
                        {
                            <form method="post" asp-page-handler="DeleteComment" asp-route-cid="@comment.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete comment</button>
                            </form>
                        }

                        @if (comment.Replies?.Any() == true)
                        {
                            <button type="button"
                                    class="reply-toggle"
                                    data-reply-toggle
                                    aria-expanded="false"
                                    aria-controls="replies-@comment.Id">
                                Show replies (@comment.Replies.Count)
                            </button>

                            <div class="replies" id="replies-@comment.Id">
                                @foreach (var reply in comment.Replies)
                                {
                                    <article class="reply-item">
                                        <strong class="comment-author">@reply.User.Username</strong>
                                        <p class="comment-content">@reply.Content</p>

                                        @if (Model.CurrentUser != null && (Model.CurrentUser.IsAdmin || Model.CurrentUser.Id == reply.User.Id))
                                        {
                                            <form method="post" asp-page-handler="DeleteReply" asp-route-rid="@reply.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete reply</button>
                                            </form>
                                        }
                                    </article>
                                }
                            </div>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-page-handler="SubmitReply" class="reply-form">
                                <input type="hidden" asp-for="NewReply.replyCommentId" value="@comment.Id" />
                                <label asp-for="NewReply.ReplyText" class="visually-hidden">Write a reply</label>
                                <textarea asp-for="NewReply.ReplyText" class="form-control" rows="2" placeholder="Write a reply..." required></textarea>
                                <button type="submit" class="btn btn-sm btn-secondary mt-2">Reply</button>
                            </form>
                        }
                    </article>
                }
            </div>
        }
    </section>
</article>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll("[data-reply-toggle]").forEach((button) => {
                button.addEventListener("click", () => {
                    const replies = document.getElementById(button.getAttribute("aria-controls"));
                    if (!replies) {
                        return;
                    }

                    const isExpanded = button.getAttribute("aria-expanded") === "true";
                    button.setAttribute("aria-expanded", String(!isExpanded));
                    replies.style.display = isExpanded ? "none" : "block";
                    button.textContent = isExpanded
                        ? button.textContent.replace("Hide", "Show")
                        : button.textContent.replace("Show", "Hide");
                });
            });

            const container = document.getElementById("postContent");
            if (!container) {
                return;
            }

            const youtubePattern = /(https?:\/\/(?:www\.)?(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})(?:[^\s<]*)?)/g;
            container.innerHTML = container.innerHTML.replace(youtubePattern, (_, url, videoId) => `
                <div class="video-embed">
                    <iframe src="https://www.youtube.com/embed/${videoId}"
                            title="Embedded YouTube video"
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
            `);
        });
    </script>
}

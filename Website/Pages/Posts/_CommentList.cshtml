@model Website.Models.PostCommentsViewModel

<div id="commentsRegion" data-comments-region>
    @if (Model.Comments.Count == 0)
    {
        <div class="empty-state comment-empty-state">
            <strong>No comments yet</strong>
            <span>Start the conversation.</span>
        </div>
    }
    else
    {
        <div class="comment-list">
            @foreach (var comment in Model.Comments)
            {
                var commentAuthor = string.IsNullOrWhiteSpace(comment.User.Username)
                    ? "User"
                    : comment.User.Username;
                var commentInitial = commentAuthor[..1].ToUpperInvariant();
                var replyLabel = comment.Replies.Count == 1 ? "reply" : "replies";

                <article class="comment-card" id="comment-@comment.Id" data-comment-id="@comment.Id">
                    <span class="comment-avatar" aria-hidden="true">@commentInitial</span>

                    <div class="comment-main">
                        <div class="comment-bubble">
                            <header class="comment-header">
                                <a class="comment-author" asp-page="/UserProfile" asp-route-id="@comment.User.Id">@commentAuthor</a>
                                <time class="comment-time" datetime="@comment.Posted_on.ToString("O")">
                                    @comment.Posted_on.ToString("dd.MM.yyyy. HH:mm")
                                </time>
                            </header>
                            <p class="comment-content">@comment.Content</p>
                        </div>

                        <div class="comment-actions">
                            @if (comment.Replies.Count > 0)
                            {
                                <button type="button"
                                        class="comment-action-button reply-toggle"
                                        data-reply-toggle
                                        data-comment-id="@comment.Id"
                                        data-reply-count="@comment.Replies.Count"
                                        aria-expanded="false"
                                        aria-controls="replies-@comment.Id">
                                    View @comment.Replies.Count @replyLabel
                                </button>
                            }

                            @if (Model.IsAuthenticated)
                            {
                                <button type="button"
                                        class="comment-action-button"
                                        data-reply-composer-toggle
                                        data-comment-id="@comment.Id"
                                        aria-expanded="false"
                                        aria-controls="reply-form-@comment.Id">
                                    Reply
                                </button>
                            }

                            @if (Model.CurrentUser != null && (Model.CurrentUser.IsAdmin || Model.CurrentUser.Id == comment.User.Id))
                            {
                                <form method="post"
                                      asp-page="/Posts/Post"
                                      asp-page-handler="DeleteComment"
                                      asp-route-id="@Model.PostId"
                                      class="comment-action-form"
                                      data-async-comment-form
                                      data-focus-after="comment-input"
                                      data-confirm-message="Delete this comment and its replies?"
                                      data-success-message="Comment deleted.">
                                    <input type="hidden" name="cid" value="@comment.Id" />
                                    <button type="submit" class="comment-action-button comment-delete">Delete</button>
                                </form>
                            }
                        </div>

                        @if (comment.Replies.Count > 0)
                        {
                            <div class="replies" id="replies-@comment.Id" hidden>
                                @foreach (var reply in comment.Replies)
                                {
                                    var replyAuthor = string.IsNullOrWhiteSpace(reply.User.Username)
                                        ? "User"
                                        : reply.User.Username;
                                    var replyInitial = replyAuthor[..1].ToUpperInvariant();

                                    <article class="reply-item" id="reply-@reply.Id">
                                        <span class="comment-avatar reply-avatar" aria-hidden="true">@replyInitial</span>
                                        <div class="reply-main">
                                            <div class="reply-bubble">
                                                <header class="comment-header">
                                                    <a class="comment-author" asp-page="/UserProfile" asp-route-id="@reply.User.Id">@replyAuthor</a>
                                                    <time class="comment-time" datetime="@reply.PostedOn.ToString("O")">
                                                        @reply.PostedOn.ToString("dd.MM.yyyy. HH:mm")
                                                    </time>
                                                </header>
                                                <p class="comment-content">@reply.Content</p>
                                            </div>

                                            @if (Model.CurrentUser != null && (Model.CurrentUser.IsAdmin || Model.CurrentUser.Id == reply.User.Id))
                                            {
                                                <form method="post"
                                                      asp-page="/Posts/Post"
                                                      asp-page-handler="DeleteReply"
                                                      asp-route-id="@Model.PostId"
                                                      class="comment-action-form reply-actions"
                                                      data-async-comment-form
                                                      data-focus-after="reply-input-@comment.Id"
                                                      data-expand-comment="@comment.Id"
                                                      data-confirm-message="Delete this reply?"
                                                      data-success-message="Reply deleted.">
                                                    <input type="hidden" name="rid" value="@reply.Id" />
                                                    <button type="submit" class="comment-action-button comment-delete">Delete</button>
                                                </form>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        }

                        @if (Model.IsAuthenticated)
                        {
                            <form method="post"
                                  asp-page="/Posts/Post"
                                  asp-page-handler="SubmitReply"
                                  asp-route-id="@Model.PostId"
                                  id="reply-form-@comment.Id"
                                  class="reply-form"
                                  data-comment-id="@comment.Id"
                                  data-async-comment-form
                                  data-focus-after="reply-input-@comment.Id"
                                  data-expand-comment="@comment.Id"
                                  data-success-message="Reply posted."
                                  hidden>
                                <input type="hidden" name="NewReply.CommentId" value="@comment.Id" />
                                <div class="reply-form-heading">Replying to <strong>@commentAuthor</strong></div>
                                <label for="reply-input-@comment.Id" class="visually-hidden">Reply to @commentAuthor</label>
                                <textarea id="reply-input-@comment.Id"
                                          name="NewReply.ReplyText"
                                          class="form-control"
                                          rows="2"
                                          maxlength="@LogicLayer.Managers.CommentManager.MaxContentLength"
                                          placeholder="Write a reply..."
                                          data-comment-focus="reply-input-@comment.Id"
                                          required></textarea>
                                <div class="reply-form-actions">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-light"
                                            data-reply-composer-toggle
                                            data-comment-id="@comment.Id"
                                            aria-controls="reply-form-@comment.Id">
                                        Cancel
                                    </button>
                                    <button type="submit" class="btn btn-sm btn-primary">Post reply</button>
                                </div>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

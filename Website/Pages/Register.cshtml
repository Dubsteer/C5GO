@page
@model Website.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        background-color: #0d1117;
        font-family: "Segoe UI", Roboto, sans-serif;
        color: #fff;
    }

    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 50px 0;
    }

    .auth-card {
        background: #161b22;
        padding: 35px;
        width: 450px;
        border-radius: 12px;
        border: 1px solid #2d333b;
        box-shadow: 0 0 10px rgba(99,102,241,0.25);
    }

        .auth-card h2 {
            text-align: center;
            margin-bottom: 25px;
            font-weight: 700;
        }

    .auth-input {
        width: 100%;
        padding: 10px;
        margin-top: 6px;
        margin-bottom: 5px;
        background: #0d1117;
        border: 1px solid #2d333b;
        color: #fff;
        border-radius: 8px;
    }

        .auth-input:focus {
            outline: none;
            border-color: #6366f1;
        }

    .field-error {
        color: #f87171;
        font-size: 13px;
        margin-bottom: 10px;
        display: block;
    }

    .auth-btn {
        width: 100%;
        padding: 12px;
        background-color: #4f46e5;
        border: none;
        border-radius: 8px;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 10px;
    }

        .auth-btn:hover {
            background-color: #6366f1;
        }

    .small-text {
        text-align: center;
        color: #9ca3af;
        margin-top: 15px;
    }

    a {
        color: #58a6ff;
        text-decoration: none;
    }
</style>

<div class="auth-container">
    <div class="auth-card">

        <h2>Create Account</h2>

        <form method="post" novalidate>

            <label>First name</label>
            <input asp-for="FullUserFormModel.Firstname" class="auth-input" />
            <span asp-validation-for="FullUserFormModel.Firstname" class="field-error"></span>

            <label>Last name</label>
            <input asp-for="FullUserFormModel.Lastname" class="auth-input" />
            <span asp-validation-for="FullUserFormModel.Lastname" class="field-error"></span>

            <label>Age</label>
            <input asp-for="FullUserFormModel.Age" type="number" class="auth-input" />
            <span asp-validation-for="FullUserFormModel.Age" class="field-error"></span>

            <label>Username</label>
            <input asp-for="FullUserFormModel.Username" class="auth-input" />
            <span asp-validation-for="FullUserFormModel.Username" class="field-error"></span>

            <label>Email</label>
            <input asp-for="FullUserFormModel.Gmail" class="auth-input" />
            <span asp-validation-for="FullUserFormModel.Gmail" class="field-error"></span>

            <label>Password</label>
            <input asp-for="FullUserFormModel.Password" type="password" class="auth-input" />
            <span asp-validation-for="FullUserFormModel.Password" class="field-error"></span>

            <input type="submit" class="auth-btn" value="Create your account" />
        </form>

        <div class="small-text">
            Already have an account? <a href="/Login">Log In</a>
        </div>

        @section scripts {
            <partial name="_ValidationScriptsPartial" />
        }
    </div>
</div>

@page
@model Website.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="auth-container" aria-labelledby="registerTitle">
    <div class="auth-card">
        <h1 id="registerTitle">Create account</h1>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="auth-field">
                <label asp-for="FullUserFormModel.Firstname">First name</label>
                <input asp-for="FullUserFormModel.Firstname" class="auth-input" autocomplete="given-name" />
                <span asp-validation-for="FullUserFormModel.Firstname" class="field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="FullUserFormModel.Lastname">Last name</label>
                <input asp-for="FullUserFormModel.Lastname" class="auth-input" autocomplete="family-name" />
                <span asp-validation-for="FullUserFormModel.Lastname" class="field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="FullUserFormModel.Age">Age</label>
                <input asp-for="FullUserFormModel.Age" class="auth-input" type="number" inputmode="numeric" />
                <span asp-validation-for="FullUserFormModel.Age" class="field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="FullUserFormModel.Username">Username</label>
                <input asp-for="FullUserFormModel.Username" class="auth-input" autocomplete="username" />
                <span asp-validation-for="FullUserFormModel.Username" class="field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="FullUserFormModel.Gmail">Email</label>
                <input asp-for="FullUserFormModel.Gmail" class="auth-input" type="email" autocomplete="email" />
                <span asp-validation-for="FullUserFormModel.Gmail" class="field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="FullUserFormModel.Password">Password</label>
                <input asp-for="FullUserFormModel.Password" class="auth-input" type="password" autocomplete="new-password" />
                <span asp-validation-for="FullUserFormModel.Password" class="field-error"></span>
            </div>

            <button type="submit" class="auth-btn">Create account</button>
        </form>

        <p class="small-text">
            Already have an account? <a asp-page="/Login">Log in</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@{
    ViewData["Title"] = "Registration successful";
}

<section class="status-container" aria-labelledby="registrationTitle">
    <div class="status-card">
        <div class="status-icon" aria-hidden="true">&#10003;</div>
        <h1 id="registrationTitle">Account created</h1>
        <p>We sent a verification link to your email address. Verify your email before logging in.</p>
        <a asp-page="/Login" class="btn btn-primary">Go to login</a>
    </div>
</section>

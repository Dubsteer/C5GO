@page
@model Website.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="auth-container" aria-labelledby="resetPasswordTitle">
    <div class="auth-card">
        @if (Model.IsTokenValid)
        {
            <h1 id="resetPasswordTitle">Create a new password</h1>
            <p class="auth-intro">Use at least 8 characters. After saving, this reset link cannot be used again.</p>

            <form method="post" novalidate>
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Form.NewPassword">New password</label>
                    <input asp-for="Form.NewPassword" class="auth-input" type="password" autocomplete="new-password" autofocus />
                    <span asp-validation-for="Form.NewPassword" class="field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Form.ConfirmPassword">Confirm new password</label>
                    <input asp-for="Form.ConfirmPassword" class="auth-input" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Form.ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="auth-btn">Save new password</button>
            </form>
        }
        else
        {
            <div class="status-icon status-icon-error" aria-hidden="true">!</div>
            <h1 id="resetPasswordTitle">Reset link unavailable</h1>
            <p class="auth-intro">This password reset link is invalid, expired, or has already been used.</p>
            <a asp-page="/ForgotPassword" class="btn btn-primary w-100">Request a new link</a>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

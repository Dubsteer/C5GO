@page
@{
    ViewData["Title"] = "Password changed";
}

<section class="status-container" aria-labelledby="resetPasswordConfirmationTitle">
    <div class="status-card">
        <div class="status-icon" aria-hidden="true">&#10003;</div>
        <h1 id="resetPasswordConfirmationTitle">Password changed</h1>
        <p>Your password was updated successfully. You can now log in with the new password.</p>
        <a asp-page="/Login" class="btn btn-primary">Go to login</a>
    </div>
</section>

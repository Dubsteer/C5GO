@using Microsoft.Extensions.Options
@using Website.Configuration
@inject IOptions<FeatureOptions> FeatureOptions
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var username = User.Identity?.Name ?? "Profile";
    var userInitial = string.IsNullOrWhiteSpace(username)
        ? "?"
        : char.ToUpperInvariant(username[0]).ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#173d3c" />
    <title>@ViewData["Title"] - C5G0</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <nav class="navbar navbar-expand-lg custom-navbar" aria-label="Main navigation">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-page="/Index" aria-label="C5G0 home">
                <img src="~/Images/C5G0_logo.png" class="nav-logo" alt="" />
                <span class="nav-title">C5G0</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Open navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(currentPage.StartsWith("/Tournaments", StringComparison.OrdinalIgnoreCase) ? "nav-active" : string.Empty)"
                           asp-page="/Tournaments">Tournaments</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPage.StartsWith("/Teams", StringComparison.OrdinalIgnoreCase) ? "nav-active" : string.Empty)"
                           asp-page="/Teams/Teams">Teams</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPage.StartsWith("/Matches", StringComparison.OrdinalIgnoreCase) ? "nav-active" : string.Empty)"
                           asp-page="/Matches/Index">Matches</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentPage == "/Index" || currentPage.StartsWith("/Posts", StringComparison.OrdinalIgnoreCase) ? "nav-active" : string.Empty)"
                           asp-page="/Index">News</a>
                    </li>
                    @if (FeatureOptions.Value.CommunityEnabled)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentPage.StartsWith("/Community", StringComparison.OrdinalIgnoreCase) ? "nav-active" : string.Empty)"
                               asp-page="/Community/Index">Community</a>
                        </li>
                    }
                    @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link admin-nav-link @(currentPage.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase) ? "nav-active" : string.Empty)"
                               asp-page="/Admin/Index">Admin</a>
                        </li>
                    }
                    else if (FeatureOptions.Value.CommunityEnabled && User.IsInRole("Moderator"))
                    {
                        <li class="nav-item">
                            <a class="nav-link admin-nav-link @(currentPage.StartsWith("/Moderation", StringComparison.OrdinalIgnoreCase) ? "nav-active" : string.Empty)"
                               asp-page="/Moderation/Reports">Moderation</a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-lg-auto align-items-lg-center nav-account-list">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item nav-account-shell">
                            @await Html.PartialAsync("_NotificationsBell")

                            <div class="dropdown profile-menu">
                                <button class="profile-menu-trigger dropdown-toggle @(currentPage is "/ViewProfile" or "/EditProfile" ? "profile-menu-active" : string.Empty)"
                                        id="profileDropdown"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Open profile menu for @username">
                                    <span class="profile-avatar" aria-hidden="true">@userInitial</span>
                                    <span class="profile-menu-name">@username</span>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end profile-menu-dropdown" aria-labelledby="profileDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-page="/ViewProfile">My profile</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/EditProfile">Edit profile</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-page="/Logout">
                                            <button class="dropdown-item profile-logout" type="submit">Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Login" ? "nav-active" : string.Empty)" asp-page="/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Register" ? "nav-active" : string.Empty)" asp-page="/Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main id="main-content" class="site-main">
        <div class="container site-content">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        &copy; @DateTime.UtcNow.Year Designed by Vladimir Stijepovic
    </footer>

    <div id="loginOverlay" class="login-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="loginOverlayTitle">
        <div class="login-modal">
            <h2 id="loginOverlayTitle">Login required</h2>
            <p>You must be logged in to perform this action.</p>
            <a asp-page="/Login" class="btn btn-primary w-100">Login</a>
            <button type="button" class="btn btn-secondary w-100 mt-2" data-close-login-modal>Cancel</button>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (FeatureOptions.Value.CommunityEnabled)
    {
        <script src="~/js/community.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">

    <link rel="stylesheet" href="/css/site.css">
    <title> News @ViewData["C5G0 news"] - C5G0 </title>
</head>
<body style="background-color: darkslategrey">
    <!-- HEADER -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-light border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img src="/Images/C5G0_logo.png" alt="C5G0 Logo" style="width: 45px; margin-right: 15px;">
                    C5G0
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp asp-page="/Index"></a>
                        </li>
                    </ul>
                    <ul class="navbar-nav navbar-left">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Register">Register</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Tournaments">Tournaments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/ViewProfile">Profile</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Logout">Logout</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENT -->
    <div class="container">
        <main role="main">
            @if (ViewData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewData["Error"]
                </div>
            }
            @if (ViewData["Message"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @ViewData["Message"]
                </div>
            }    
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->

    <footer>

        <style>
            .footer {
                position: fixed;
                bottom: 0;
                width: 100%;
                text-align: center;
                height: 60px;
                background-color: #darkslategrey;
                padding: 10px;
            }

            .footer .pics {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 10px;
            }

            .footer .pics img {
                width: 20px;
                height: 20px;
            }

            .footer p {
                margin-top: 10px;
                font-size: 12px;
                color: #333;
            }
        </style>

        <div class="footer">
            <div class="pics">
                <a href="https://www.facebook.com/vlado.stijepovic.9/"> <img src="/images/facebook.png"> </a>
                <a href="https://www.instagram.com/vladimir_stijepovic/"> <img src="/images/Instagram.png"> </a>
                <a href="mailto:dovla98765@gmail.com"> <img src="/images/Mail.png"> </a>
                <a href="https://www.twitch.tv/dubster873"> <img src="/images/twitch.png"></a>
            </div>
            <p>Copyright &copy; 2022 designed by Vladimir Stijepovic</p>
        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - C5G0</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #0d1117;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Montserrat', sans-serif;
        }

        /* ========================= */
        /* NAVBAR */
        /* ========================= */
        .custom-navbar {
            background-color: #1e3d3d;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .nav-logo {
            width: 44px;
            height: 44px;
            margin-right: 10px;
        }

        .nav-title {
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
        }

        .navbar-nav .nav-link {
            color: #e4e4e4 !important;
            font-size: 16px;
            font-weight: 600;
            transition: 0.2s;
            letter-spacing: 0.3px;
        }

            .navbar-nav .nav-link:hover {
                color: #00e3c2 !important;
            }

        .nav-active {
            color: #00e3c2 !important;
            font-weight: 700 !important;
        }

        .nav-user-box {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .nav-username {
            color: #e4e4e4;
            font-weight: 600;
            text-decoration: none;
        }

            .nav-username:hover {
                color: #00e3c2;
            }

        .logout-link {
            color: #ff8f8f !important;
            font-weight: 600;
            text-decoration: none;
        }

            .logout-link:hover {
                color: #ff4c4c !important;
            }

        main {
            flex: 1;
            padding: 40px 0;
        }

        footer {
            padding: 15px 0;
            text-align: center;
            background-color: #1e3d3d;
            color: #eaeaea;
            font-size: 14px;
        }

        /* ========================= */
        /* LOGIN MODAL + BLUR */
        /* ========================= */
        .login-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            backdrop-filter: blur(6px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

            .login-overlay.hidden {
                display: none;
            }

        .login-modal {
            background: #161b22;
            padding: 30px;
            border-radius: 14px;
            border: 1px solid #2d333b;
            width: 340px;
            text-align: center;
            color: #f0f0f0;
        }

            .login-modal h3 {
                font-size: 20px;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .login-modal p {
                font-size: 14px;
                opacity: 0.9;
                margin-bottom: 20px;
            }
    </style>
</head>

<body>

    <!-- ========================= -->
    <!-- NAVBAR -->
    <!-- ========================= -->
    <nav class="navbar navbar-expand-lg custom-navbar">
        <div class="container">

            <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                <img src="/Images/C5G0_logo.png" class="nav-logo" />
                <span class="nav-title">C5G0</span>
            </a>

            <button class="navbar-toggler text-white" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <!-- CENTER LINKS -->
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["Title"]?.ToString() == "Tournaments" ? "nav-active" : "")"
                           asp-page="/Tournaments">Tournaments</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewData["Title"]?.ToString() == "Teams" ? "nav-active" : "")"
                           asp-page="/Teams/Teams">Teams</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewData["Title"]?.ToString() == "Posts" ? "nav-active" : "")"
                           asp-page="/Index">Posts</a>
                    </li>

                    @* ===== ADMIN LINK (S A M O  A D M I N) ===== *@
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.Identity.Name == "admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               style="color:#ffcc00; font-weight:700;"
                               href="/Admin/Posts/Manage">
                                Admin
                            </a>
                        </li>
                    }
                </ul>

                <!-- RIGHT SIDE -->
                <ul class="navbar-nav ms-lg-auto align-items-lg-center">
                    @if (User?.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- 🔔 NOTIFICATIONS -->
                        @await Html.PartialAsync("_NotificationsBell")

                        <li class="nav-item nav-user-box">
                            <a class="nav-username" href="/ViewProfile">
                                @User.Identity.Name
                            </a>
                            <a class="logout-link" href="/Logout">
                                Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Register">Register</a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        © 2025 Designed by Vladimir Stijepovic
    </footer>

    <!-- ========================= -->
    <!-- LOGIN REQUIRED MODAL -->
    <!-- ========================= -->
    <div id="loginOverlay" class="login-overlay hidden">
        <div class="login-modal">
            <h3>Login required</h3>
            <p>You must be logged in to perform this action.</p>

            <a href="/Login" class="btn btn-primary w-100">
                Login
            </a>

            <button class="btn btn-secondary w-100 mt-2" onclick="closeLoginModal()">
                Cancel
            </button>
        </div>
    </div>

    <script>
        function requireLogin() {
            document.getElementById("loginOverlay").classList.remove("hidden");
        }

        function closeLoginModal() {
            document.getElementById("loginOverlay").classList.add("hidden");
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
    

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - C5G0</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #0d1117;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .custom-navbar {
            background-color: #1e3d3d;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .nav-logo {
            width: 48px;
            height: 48px;
            margin-right: 10px;
        }

        .nav-title {
            font-size: 24px;
            font-weight: 700;
            color: #ffffff;
            font-family: 'Montserrat', sans-serif;
        }

        .center-nav {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 25px;
        }

            .center-nav a {
                color: #e4e4e4 !important;
                font-size: 17px;
                font-weight: 600;
                transition: 0.2s;
            }

                .center-nav a:hover {
                    color: #00e3c2 !important;
                }

        .nav-active {
            color: #00e3c2 !important;
            font-weight: 700;
        }

        .nav-user-box {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .nav-username {
            font-weight: 800;
            font-size: 18px;
            letter-spacing: 0.3px;
            color: #ffffff !important;
        }

        .logout-link {
            color: #ff8f8f !important;
            font-weight: 600;
            font-size: 16px;
            transition: 0.2s;
        }

            .logout-link:hover {
                color: #ff4c4c !important;
            }

        main {
            flex: 1;
            padding-top: 40px;
            padding-bottom: 40px;
        }

        footer {
            padding: 15px 0;
            text-align: center;
            background-color: #1e3d3d;
            color: #eaeaea;
            font-size: 14px;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg custom-navbar">
        <div class="container position-relative">

            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                <img src="/Images/C5G0_logo.png" class="nav-logo">
                <span class="nav-title">C5G0</span>
            </a>

            <div class="center-nav">

                <a class="@(ViewData["Title"]?.ToString() == "Tournaments" ? "nav-active" : "")"
                   asp-page="/Tournaments">Tournaments</a>

                <a class="@(ViewData["Title"]?.ToString() == "Teams" ? "nav-active" : "")"
                   asp-page="/Teams/Teams">Teams</a>

                <a class="@(ViewData["Title"]?.ToString() == "Posts" ? "nav-active" : "")"
                   asp-page="/Index">Posts</a>

            </div>

            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav align-items-center">

                    @if (User?.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item nav-user-box">
                            <a class="nav-username" href="/ViewProfile">
                                @User.Identity.Name
                            </a>
                            <a class="logout-link" href="/Logout">
                                Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Register">Register</a>
                        </li>
                    }

                </ul>
            </div>

        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        © 2025 Designed by Vladimir Stijepovic
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>

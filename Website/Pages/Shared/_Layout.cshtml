<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - C5G0</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #0d1117;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Montserrat', sans-serif;
        }

        /* NAVBAR */
        .custom-navbar {
            background-color: #1e3d3d;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .nav-logo {
            width: 44px;
            height: 44px;
            margin-right: 10px;
        }

        .nav-title {
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
        }

        .navbar-nav .nav-link {
            color: #e4e4e4 !important;
            font-size: 16px;
            font-weight: 600;
            transition: 0.2s;
            letter-spacing: 0.3px;
        }

            .navbar-nav .nav-link:hover {
                color: #00e3c2 !important;
            }

        .nav-active {
            color: #00e3c2 !important;
            font-weight: 700 !important;
        }

        .nav-user-box {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .nav-username {
            color: #e4e4e4;
            font-weight: 600;
            text-decoration: none;
        }

            .nav-username:hover {
                color: #00e3c2;
            }

        .logout-link {
            color: #ff8f8f !important;
            font-weight: 600;
            text-decoration: none;
        }

            .logout-link:hover {
                color: #ff4c4c !important;
            }

        main {
            flex: 1;
            padding: 40px 0;
        }

        footer {
            padding: 15px 0;
            text-align: center;
            background-color: #1e3d3d;
            color: #eaeaea;
            font-size: 14px;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg custom-navbar">
        <div class="container">

            <!-- LOGO -->
            <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                <img src="/Images/C5G0_logo.png" class="nav-logo" />
                <span class="nav-title">C5G0</span>
            </a>

            <!-- HAMBURGER -->
            <button class="navbar-toggler text-white" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- COLLAPSIBLE CONTENT -->
            <div class="collapse navbar-collapse" id="mainNavbar">

                <!-- CENTER LINKS -->
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["Title"]?.ToString() == "Tournaments" ? "nav-active" : "")"
                           asp-page="/Tournaments">Tournaments</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["Title"]?.ToString() == "Teams" ? "nav-active" : "")"
                           asp-page="/Teams/Teams">Teams</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["Title"]?.ToString() == "Posts" ? "nav-active" : "")"
                           asp-page="/Index">Posts</a>
                    </li>
                </ul>

                <!-- RIGHT SIDE -->
                <ul class="navbar-nav ms-lg-auto align-items-lg-center">
                    @if (User?.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item nav-user-box">
                            <a class="nav-username" href="/ViewProfile">
                                @User.Identity.Name
                            </a>
                            <a class="logout-link" href="/Logout">
                                Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Register">Register</a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        © 2025 Designed by Vladimir Stijepovic
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>

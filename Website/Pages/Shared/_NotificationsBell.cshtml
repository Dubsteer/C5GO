@using LogicLayer.Models
@inject LogicLayer.Managers.NotificationManager NotificationManager
@inject ILoggerFactory LoggerFactory

@{
    IReadOnlyList<Notification> notifications = [];
    var unread = 0;
    var isAvailable = true;
    if (int.TryParse(User.FindFirst("id")?.Value, out var userId))
    {
        try
        {
            notifications = NotificationManager.GetForUser(userId, 5);
            unread = NotificationManager.GetUnreadCount(userId);
        }
        catch (Exception exception)
        {
            isAvailable = false;
            LoggerFactory
                .CreateLogger("NotificationBell")
                .LogWarning(exception, "Unable to load notifications for user {UserId}.", userId);
        }
    }
}

<div class="dropdown nav-notification">
    <button class="position-relative notification-trigger"
            id="notifDropdown"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Notifications@(unread > 0 ? $", {unread} unread" : string.Empty)">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
        </svg>
        @if (unread > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @(unread > 99 ? "99+" : unread.ToString())
                <span class="visually-hidden">unread notifications</span>
            </span>
        }
    </button>

    <div class="dropdown-menu dropdown-menu-end notification-menu" aria-labelledby="notifDropdown">
        <header class="notification-menu-header">
            <div>
                <strong>Notifications</strong>
                <span>@(unread == 0 ? "You're all caught up" : $"{unread} unread")</span>
            </div>
            @if (unread > 0)
            {
                <form method="post" asp-page="/Notifications/Index" asp-page-handler="MarkAllRead">
                    <button type="submit">Mark all read</button>
                </form>
            }
        </header>

        <div class="notification-menu-list">
            @if (!isAvailable)
            {
                <div class="notification-menu-empty">
                    <strong>Notifications are unavailable</strong>
                    <span>Try again in a moment.</span>
                </div>
            }
            else if (!notifications.Any())
            {
                <div class="notification-menu-empty">
                    <strong>No notifications yet</strong>
                    <span>Team and Community updates will appear here.</span>
                </div>
            }
            else
            {
                foreach (var notification in notifications)
                {
                    <form method="post" asp-page="/Notifications/Read" class="notification-preview-form">
                        <input type="hidden" name="id" value="@notification.Id" />
                        <button type="submit" class="notification-preview @(notification.IsRead ? "is-read" : "is-unread")">
                            <span class="notification-state-dot" aria-hidden="true"></span>
                            <span class="notification-preview-copy">
                                <strong>@notification.Message</strong>
                                <time datetime="@notification.CreatedAt.ToString("O")">
                                    @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </time>
                            </span>
                        </button>
                    </form>
                }
            }
        </div>

        <footer class="notification-menu-footer">
            <a asp-page="/Notifications/Index">View all notifications</a>
        </footer>
    </div>
</div>

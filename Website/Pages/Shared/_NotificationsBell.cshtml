@using LogicLayer.Models
@inject LogicLayer.Managers.NotificationManager NotificationManager

@{
    var notifications = new List<Notification>();
    var unread = 0;
    if (int.TryParse(User.FindFirst("id")?.Value, out var userId))
    {
        notifications = NotificationManager.GetForUser(userId);
        unread = NotificationManager.GetUnreadCount(userId);
    }
}

<li class="nav-item dropdown">
    <button class="nav-link dropdown-toggle position-relative notification-trigger"
            id="notifDropdown"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Notifications@(unread > 0 ? $", {unread} unread" : string.Empty)">
        <span aria-hidden="true">&#128276;</span>
        @if (unread > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @unread
                <span class="visually-hidden">unread notifications</span>
            </span>
        }
    </button>

    <ul class="dropdown-menu dropdown-menu-end notification-menu" aria-labelledby="notifDropdown">
        @if (!notifications.Any())
        {
            <li><span class="dropdown-item-text text-secondary">No notifications</span></li>
        }
        else
        {
            foreach (var notification in notifications)
            {
                <li>
                    <a class="dropdown-item @(notification.IsRead ? string.Empty : "fw-bold")"
                       asp-page="/Notifications/Read"
                       asp-route-id="@notification.Id"
                       asp-route-link="@notification.Link">
                        @notification.Message
                        <span class="d-block text-secondary small">
                            @notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </a>
                </li>
            }
        }
    </ul>
</li>

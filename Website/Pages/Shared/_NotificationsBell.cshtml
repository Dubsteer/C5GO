@using LogicLayer.Models
@inject LogicLayer.Managers.NotificationManager NotificationManager

@{
    int userId = int.Parse(User.FindFirst("id").Value);
    var notifications = NotificationManager.GetForUser(userId);
    int unread = NotificationManager.GetUnreadCount(userId);
}

<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle position-relative"
       href="#"
       id="notifDropdown"
       role="button"
       data-bs-toggle="dropdown"
       aria-expanded="false">

        🔔
        @if (unread > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @unread
            </span>
        }
    </a>

    <ul class="dropdown-menu dropdown-menu-end"
        style="
            width: 320px;
            max-height: 400px;
            overflow-y: auto;
            overflow-x: hidden;
            white-space: normal;
        ">

        @if (!notifications.Any())
        {
            <li class="dropdown-item text-muted">
                No notifications
            </li>
        }
        else
        {
            foreach (var n in notifications)
            {
                <li>
                    <a class="dropdown-item @(n.IsRead ? "" : "fw-bold")"
                       asp-page="/Notifications/Read"
                       asp-route-id="@n.Id"
                       asp-route-link="@n.Link"
                       style="white-space: normal; word-break: break-word;">

                        @n.Message
                        <br />
                        <small class="text-muted">
                            @n.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </small>
                    </a>
                </li>
            }
        }
    </ul>
</li>

@page "/Teams/Create"
@model Website.Pages.Teams.CreateModel
@{
    ViewData["Title"] = "Create team";
}

<section class="create-box" aria-labelledby="createTeamTitle">
    <a asp-page="/Teams/Teams" class="back-link">&larr; Back to teams</a>
    <h1 id="createTeamTitle" class="mt-2 mb-4">Create a team</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-text" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="mb-3">
            <label asp-for="TeamName" class="form-label">Team name</label>
            <input asp-for="TeamName" class="form-control" maxlength="100" autocomplete="off" required />
        </div>
        <button type="submit" class="btn btn-success w-100">Create team</button>
    </form>
</section>

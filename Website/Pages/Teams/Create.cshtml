@page "/Teams/Create"
@model Website.Pages.Teams.CreateModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #0d1117;
        color: white;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    .create-box {
        background: #161b22;
        padding: 30px;
        border-radius: 12px;
        max-width: 550px;
        margin: 70px auto;
        border: 1px solid #2d333b;
        box-shadow: 0 0 12px rgba(99,102,241,0.25);
    }

    h2 {
        text-align: center;
        margin-bottom: 25px;
        color: #a5b4fc;
        font-weight: 700;
    }

    label {
        color: #cbd5e1;
        margin-bottom: 6px;
    }

    .btn-create {
        width: 100%;
        padding: 10px;
        background-color: #4f46e5;
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-create:hover {
            background-color: #6366f1;
        }

    .error-text {
        color: #ff6b6b;
        margin-top: 10px;
        text-align: center;
        font-size: 15px;
    }
</style>

<div class="create-box">
    <h2>Create a Team</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-text">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="mb-3">
            <label for="teamName">Team Name</label>
            <input type="text" id="teamName" name="TeamName" class="form-control" maxlength="100" required />
        </div>

        <button type="submit" class="btn-create">Create Team</button>
    </form>
</div>

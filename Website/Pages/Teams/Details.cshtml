@page
@model Website.Pages.Teams.DetailsModel
@{
    ViewData["Title"] = "Team details";
}

<section class="team-details-card" aria-labelledby="teamTitle">
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <header class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <a asp-page="/Teams/Teams" class="back-link">&larr; Back to teams</a>
            <h1 id="teamTitle" class="mt-2 mb-0">@Model.Team.Name</h1>
        </div>
        <span class="tag tag-team">@Model.Members.Count / 5 members</span>
    </header>

    <section aria-labelledby="membersTitle">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 id="membersTitle" class="section-heading mb-0">Members</h2>
            @if (Model.IsCaptain)
            {
                <form method="post" asp-page-handler="Leave" onsubmit="return confirm('Delete this team?');">
                    <input type="hidden" name="teamId" value="@Model.Team.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete team</button>
                </form>
            }
        </div>

        <div class="member-list">
            @foreach (var member in Model.Members)
            {
                <div class="member-pill">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                        <div>
                            <a asp-page="/UserProfile" asp-route-id="@member.Id" class="user-link">@member.Username</a>
                            @if (member.Id == Model.Team.Captain.Id)
                            {
                                <span class="captain-tag">Captain</span>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            @if (Model.IsCaptain && member.Id != Model.Team.Captain.Id)
                            {
                                <form method="post" asp-page-handler="Kick" onsubmit="return confirm('Remove this member from the team?');">
                                    <input type="hidden" name="userId" value="@member.Id" />
                                    <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                                </form>
                            }

                            @if (member.Id == Model.CurrentUser.Id && !Model.IsCaptain)
                            {
                                <form method="post" asp-page-handler="Leave" onsubmit="return confirm('Leave this team?');">
                                    <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                    <button type="submit" class="btn btn-outline-warning btn-sm">Leave team</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    @if (Model.IsCaptain)
    {
        <hr class="section-divider" />
        <section aria-labelledby="requestsTitle">
            <h2 id="requestsTitle" class="section-heading">Join requests</h2>

            @if (!Model.Pending.Any())
            {
                <div class="empty-state">
                    <strong>No pending requests</strong>
                    <span>New requests will appear here.</span>
                </div>
            }
            else
            {
                <div class="request-list">
                    @foreach (var request in Model.Pending)
                    {
                        <div class="pending-pill">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                <a asp-page="/UserProfile" asp-route-id="@request.User.Id" class="user-link">@request.User.Username</a>
                                <div class="d-flex gap-2">
                                    <form method="post" asp-page-handler="Approve">
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                    </form>
                                    <form method="post" asp-page-handler="Reject">
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</section>

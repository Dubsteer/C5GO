@page "{id:int}"
@model Website.Pages.Teams.DetailsModel
@{
    ViewData["Title"] = "Team Details";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #0d1117;
        color: white;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    .box {
        background: #161b22;
        padding: 25px;
        border-radius: 12px;
        max-width: 700px;
        margin: 40px auto;
        border: 1px solid #2d333b;
    }

    h2 {
        color: #a5b4fc;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .member-row {
        padding: 8px;
        border-bottom: 1px solid #2d333b;
        display: flex;
        justify-content: space-between;
    }

    .kick-btn {
        background: #ef4444;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        color: white;
    }

    .user-link {
        color: #58a6ff !important;
        font-weight: 600;
        text-decoration: none;
    }

        .user-link:hover {
            color: #7fbaff !important;
            text-decoration: underline;
        }
</style>

<div class="box">

    <h2>@Model.Team.Name</h2>

    <h4>Captain</h4>
    <p>
        <a asp-page="/UserProfile" asp-route-id="@Model.Team.Captain.Id" class="user-link">
            @Model.Team.Captain.Username
        </a>
    </p>

    <hr />

    <h4>Members</h4>

    @foreach (var m in Model.Members)
    {
        <div class="member-row">
            <span>
                <a asp-page="/UserProfile" asp-route-id="@m.Id" class="user-link">
                    @m.Username
                </a>
            </span>

            @* Kick — only for captain & cannot kick himself *@
            @if (Model.CurrentUser.Id == Model.Team.Captain.Id && m.Id != Model.Team.Captain.Id)
            {
                <form method="post" asp-page-handler="Kick">
                    <input type="hidden" name="userId" value="@m.Id" />
                    <input type="hidden" name="teamId" value="@Model.Team.Id" />
                    <button class="kick-btn">Kick</button>
                </form>
            }
        </div>
    }

    <hr />

    @* Leave Team (only non-captain) *@
    @if (Model.CurrentUser.Id != Model.Team.Captain.Id)
    {
        <form method="post" asp-page-handler="Leave">
            <input type="hidden" name="teamId" value="@Model.Team.Id" />
            <button class="btn btn-warning mt-3">Leave Team</button>
        </form>
    }

    <hr />

    <h4>Pending Join Requests</h4>

    @if (Model.Pending.Count == 0)
    {
        <p style="color:gray;">No pending requests</p>
    }
    else
    {
        @foreach (var r in Model.Pending)
        {
            <div class="member-row">
                <span>
                    <a asp-page="/UserProfile" asp-route-id="@r.User.Id" class="user-link">
                        @r.User.Username
                    </a>
                </span>

                <div>
                    @* Approve *@
                    <form method="post" asp-page-handler="Approve" style="display:inline-block;">
                        <input type="hidden" name="requestId" value="@r.Id" />
                        <input type="hidden" name="teamId" value="@Model.Team.Id" />
                        <button class="btn btn-success btn-sm">Approve</button>
                    </form>

                    @* Reject *@
                    <form method="post" asp-page-handler="Reject" style="display:inline-block;">
                        <input type="hidden" name="requestId" value="@r.Id" />
                        <input type="hidden" name="teamId" value="@Model.Team.Id" />
                        <button class="btn btn-danger btn-sm">Reject</button>
                    </form>
                </div>
            </div>
        }
    }

</div>

@page
@model Website.Pages.Teams.DetailsModel
@{
    ViewData["Title"] = "Team Details";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #0d1117;
        color: #e2e2e2;
        font-family: 'Segoe UI', Roboto, sans-serif;
    }

    .team-card {
        background: #161b22;
        border: 1px solid #2d333b;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 30px;
    }

    h2, h3 {
        color: #ffffff;
        font-weight: 700;
    }

    .member-pill {
        background: #1f2937;
        border-radius: 8px;
        padding: 10px 15px;
        font-size: 16px;
        margin-bottom: 6px;
        border: 1px solid #374151;
    }

    .pending-pill {
        background: #312e81;
        border-radius: 8px;
        padding: 10px 15px;
        font-size: 16px;
        margin-bottom: 6px;
        color: #c7d2fe;
        border: 1px solid #4338ca;
    }

    .captain-tag {
        padding: 4px 8px;
        font-size: 12px;
        background-color: #2563eb;
        margin-left: 10px;
        border-radius: 6px;
    }

    .btn-action {
        margin-left: 10px;
    }
</style>

<div class="container mt-5">

    <!-- ALERTS -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Success"]</div>
    }

    <div class="team-card">
        <h2>@Model.Team.Name</h2>

        <hr />

        <!-- MEMBERS -->
        <h3>Members</h3>

        @foreach (var m in Model.Members)
        {
            <div class="member-pill d-flex justify-content-between align-items-center">

                <div>
                    @m.Username

                    @if (m.Id == Model.Team.Captain.Id)
                    {
                        <span class="captain-tag">CAPTAIN</span>
                    }
                </div>

                @* KICK BUTTON *@
                @if (Model.CurrentUser.Id == Model.Team.Captain.Id && m.Id != Model.Team.Captain.Id)
                {
                    <form method="post" asp-page-handler="Kick" class="d-inline">
                        <input type="hidden" name="userId" value="@m.Id" />
                        <input type="hidden" name="teamId" value="@Model.Team.Id" />
                        <button class="btn btn-danger btn-sm btn-action">Kick</button>
                    </form>
                }

                @* LEAVE BUTTON *@
                @if (m.Id == Model.CurrentUser.Id && m.Id != Model.Team.Captain.Id)
                {
                    <form method="post" asp-page-handler="Leave" class="d-inline">
                        <input type="hidden" name="teamId" value="@Model.Team.Id" />
                        <button class="btn btn-warning btn-sm btn-action">Leave</button>
                    </form>
                }
            </div>
        }

        <hr />

        <!-- PENDING REQUESTS -->
        <h3>Join Requests</h3>

        @if (!Model.Pending.Any())
        {
            <p>No pending requests.</p>
        }
        else
        {
            @foreach (var r in Model.Pending)
            {
                <div class="pending-pill d-flex justify-content-between align-items-center">

                    <span>@r.User.Username</span>

                    <div>
                        <form method="post" asp-page-handler="Approve" class="d-inline">
                            <input type="hidden" name="requestId" value="@r.Id" />
                            <input type="hidden" name="teamId" value="@Model.Team.Id" />
                            <button class="btn btn-success btn-sm btn-action">Approve</button>
                        </form>

                        <form method="post" asp-page-handler="Reject" class="d-inline">
                            <input type="hidden" name="requestId" value="@r.Id" />
                            <input type="hidden" name="teamId" value="@Model.Team.Id" />
                            <button class="btn btn-danger btn-sm btn-action">Reject</button>
                        </form>
                    </div>

                </div>
            }
        }

    </div>
</div>

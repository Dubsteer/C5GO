@page
@model Website.Pages.Teams.DetailsModel
@{
    ViewData["Title"] = "Team details";
}

<section class="team-details-card" aria-labelledby="teamTitle">
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <header class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <a asp-page="/Teams/Teams" class="back-link">&larr; Back to teams</a>
            <h1 id="teamTitle" class="mt-2 mb-0">@Model.Team.Name</h1>
        </div>
        <span class="tag tag-team">@Model.Members.Count / 5 members</span>
    </header>

    <section aria-labelledby="membersTitle">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 id="membersTitle" class="section-heading mb-0">Members</h2>
            @if (Model.IsCaptain)
            {
                <form method="post" asp-page-handler="Leave" data-confirm="Delete this team?">
                    <input type="hidden" name="teamId" value="@Model.Team.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete team</button>
                </form>
            }
        </div>

        <div class="member-list">
            @foreach (var member in Model.Members)
            {
                <div class="member-pill">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                        <div>
                            <a asp-page="/UserProfile" asp-route-id="@member.Id" class="user-link">@member.Username</a>
                            @if (member.Id == Model.Team.Captain.Id)
                            {
                                <span class="captain-tag">Captain</span>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            @if (Model.IsCaptain && member.Id != Model.Team.Captain.Id)
                            {
                                <form method="post" asp-page-handler="Kick" data-confirm="Remove this member from the team?">
                                    <input type="hidden" name="userId" value="@member.Id" />
                                    <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                                </form>
                            }

                            @if (member.Id == Model.CurrentUser.Id && !Model.IsCaptain)
                            {
                                <form method="post" asp-page-handler="Leave" data-confirm="Leave this team?">
                                    <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                    <button type="submit" class="btn btn-outline-warning btn-sm">Leave team</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <hr class="section-divider" />

    <section aria-labelledby="teamHistoryTitle">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 id="teamHistoryTitle" class="section-heading mb-0">Recent match history</h2>
            <a asp-page="/Matches/History" asp-fragment="teamHistoryTitle" class="back-link">View all results</a>
        </div>

        @if (!Model.RecentMatches.Any())
        {
            <div class="empty-state">
                <strong>No completed matches</strong>
                <span>Completed C5GO team tournament matches will appear here.</span>
            </div>
        }
        else
        {
            <div class="team-history-list">
                @foreach (var match in Model.RecentMatches)
                {
                    var isTeamOne = match.Team1Id == Model.Team.Id;
                    var opponent = isTeamOne ? match.Team2 : match.Team1;
                    var teamScore = isTeamOne ? match.Team1Score : match.Team2Score;
                    var opponentScore = isTeamOne ? match.Team2Score : match.Team1Score;
                    var won = teamScore > opponentScore;
                    var tournamentName = string.IsNullOrWhiteSpace(match.TournamentName) ? $"Tournament #{match.TournamentId}" : match.TournamentName;

                    <article class="player-history-card">
                        <div class="player-history-result @(won ? "result-win" : "result-loss")">
                            <span>@(won ? "Win" : "Loss")</span>
                            <strong>@teamScore - @opponentScore</strong>
                        </div>
                        <div class="player-history-opponent">
                            <span class="history-label">Opponent</span>
                            <a asp-page="/Teams/Details" asp-route-id="@opponent.Id">@opponent.Name</a>
                        </div>
                        <div class="player-history-meta">
                            <a asp-page="/Tournaments/Details" asp-route-id="@match.TournamentId">@tournamentName</a>
                            <time datetime="@match.MatchDate.ToString("O")">@match.MatchDate.ToString("dd.MM.yyyy")</time>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    @if (Model.IsCaptain)
    {
        <hr class="section-divider" />
        <section aria-labelledby="requestsTitle">
            <h2 id="requestsTitle" class="section-heading">Join requests</h2>

            @if (!Model.Pending.Any())
            {
                <div class="empty-state">
                    <strong>No pending requests</strong>
                    <span>New requests will appear here.</span>
                </div>
            }
            else
            {
                <div class="request-list">
                    @foreach (var request in Model.Pending)
                    {
                        <div class="pending-pill">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                <a asp-page="/UserProfile" asp-route-id="@request.User.Id" class="user-link">@request.User.Username</a>
                                <div class="d-flex gap-2">
                                    <form method="post" asp-page-handler="Approve">
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                    </form>
                                    <form method="post" asp-page-handler="Reject">
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</section>

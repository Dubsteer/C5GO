@page "/Teams/Teams"
@model Website.Pages.Teams.TeamsModel
@{
    ViewData["Title"] = "Teams";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #0d1117;
        color: #f0f0f0;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    h1 {
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .team-card {
        background: #161b22;
        border-radius: 12px;
        padding: 22px;
        border: 1px solid #2d333b;
        transition: transform .20s ease, box-shadow .20s ease;
        min-height: 220px;
        margin-bottom: 35px;
        color: #ffffff !important; /* OVDJE JE GRESKA BILA */
    }

        .team-card h3,
        .team-card p,
        .team-card strong,
        .team-card span,
        .team-card li,
        .team-card h6 {
            color: #ffffff !important;
        }

        .team-card:hover {
            transform: scale(1.03);
            box-shadow: 0px 0px 10px rgba(99, 102, 241, 0.4);
            border-color: #6366f1;
        }

    .btn-sm {
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 14px;
    }
</style>

<div class="container mt-5">

    <h1 class="text-center">Teams</h1>

    <!-- CREATE TEAM -->
    @if (Model.MyTeam == null)
    {
        <div class="text-center mb-4">
            <form method="post" asp-page-handler="CreateTeam" class="d-inline-block">
                <input type="text" name="teamName" placeholder="Team name"
                       class="form-control d-inline-block"
                       style="width: 200px; display:inline-block;" required />

                <button class="btn btn-success ms-2">Create Team</button>
            </form>
        </div>
    }
    else
    {
        <div class="text-center mb-4">
            <a class="btn btn-warning" asp-page="/Teams/Details" asp-route-id="@Model.MyTeam.Id">
                Manage My Team
            </a>
        </div>
    }

    <div class="row g-4">
        @foreach (var t in Model.AllTeams)
        {
            <div class="col-md-4">
                <div class="team-card">

                    <h3>@t.Name</h3>
                    <p><strong>Captain:</strong> @t.Captain.Username</p>
                    <p><strong>Members:</strong> @t.Members.Count / 5</p>

                    <button class="btn btn-secondary btn-sm" type="button"
                            onclick="document.getElementById('m_@t.Id').classList.toggle('d-none')">
                        Show members
                    </button>

                    <div id="m_@t.Id" class="d-none mt-2">
                        @if (t.Members.Count > 0)
                        {
                            <ul>
                                @foreach (var p in t.Members)
                                {
                                    <li>@p.Username</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p style="color:gray; font-style:italic;">No members yet.</p>
                        }
                    </div>

                    <div class="mt-3">

                        <!-- JOIN TEAM -->
                        @if (Model.MyTeam == null)
                        {
                            if (!Model.PendingRequests.Contains(t.Id))
                            {
                                <form method="post" asp-page-handler="Join">
                                    <input type="hidden" name="teamId" value="@t.Id" />
                                    <button class="btn btn-primary btn-sm">Join Team</button>
                                </form>
                            }
                            else
                            {
                                <span style="color:#aaa;">Request sent...</span>
                            }
                        }

                        <!-- CAPTAIN OPTIONS -->
                        @if (Model.MyTeam != null &&
                                            Model.MyTeam.Id == t.Id &&
                                            Model.MyTeam.Captain.Id == Model.CurrentUser.Id)
                        {
                            <hr />
                            <h6>Pending Requests:</h6>

                            @if (Model.TeamManager.GetJoinRequests(t.Id).Count == 0)
                            {
                                <span style="color:gray;">No pending requests</span>
                            }
                            else
                            {
                                foreach (var r in Model.TeamManager.GetJoinRequests(t.Id))
                                {
                                    <div class="mt-2">
                                        <strong>@r.User.Username</strong>

                                        <form method="post" asp-page-handler="Approve" style="display:inline;">
                                            <input type="hidden" name="requestId" value="@r.Id" />
                                            <button class="btn btn-success btn-sm">Approve</button>
                                        </form>

                                        <form method="post" asp-page-handler="Reject" style="display:inline;">
                                            <input type="hidden" name="requestId" value="@r.Id" />
                                            <button class="btn btn-danger btn-sm">Reject</button>
                                        </form>
                                    </div>
                                }
                            }
                        }

                    </div>
                </div>
            </div>
        }
    </div>
</div>

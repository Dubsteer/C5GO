@page "/Teams/Teams"
@model Website.Pages.Teams.TeamsModel
@{
    ViewData["Title"] = "Teams";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #0d1117;
        color: #f0f0f0;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    h1 {
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .team-card {
        background: #161b22;
        border-radius: 12px;
        padding: 22px;
        border: 1px solid #2d333b;
        transition: transform .20s ease, box-shadow .20s ease;
        min-height: 220px;
        margin-bottom: 35px;
        color: #ffffff !important;
    }

        .team-card:hover {
            transform: scale(1.03);
            box-shadow: 0px 0px 10px rgba(99, 102, 241, 0.4);
            border-color: #6366f1;
        }

    .user-link {
        color: #58a6ff !important;
        font-weight: 600;
        text-decoration: none;
    }
</style>

<div class="container mt-5">

    <h1 class="text-center">Teams</h1>

    <!-- ALERTS -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success text-center">
            @TempData["Message"]
        </div>
    }

    @if (Model.MyTeam == null)
    {
        <div class="text-center mb-4">
            <form method="post" asp-page-handler="CreateTeam" class="d-inline-block">
                <input type="text" name="teamName" placeholder="Team name"
                       class="form-control d-inline-block"
                       style="width: 200px;" required />
                <button class="btn btn-success ms-2">Create Team</button>
            </form>
        </div>
    }
    else
    {
        <div class="text-center mb-4">
            <a class="btn btn-warning" asp-page="/Teams/Details" asp-route-id="@Model.MyTeam.Id">
                Manage My Team
            </a>
        </div>
    }

    <div class="row g-4">
        @foreach (var t in Model.AllTeams)
        {
            <div class="col-md-4">
                <div class="team-card">

                    <h3>@t.Name</h3>

                    <p>
                        <strong>Captain:</strong>
                        <a asp-page="/UserProfile" asp-route-id="@t.Captain.Id" class="user-link">
                            @t.Captain.Username
                        </a>
                    </p>

                    <p><strong>Members:</strong> @t.Members.Count / 5</p>

                    <button class="btn btn-secondary btn-sm" type="button"
                            onclick="document.getElementById('m_@t.Id').classList.toggle('d-none')">
                        Show members
                    </button>

                    <div id="m_@t.Id" class="d-none mt-2">
                        @if (t.Members.Count > 0)
                        {
                            <ul>
                                @foreach (var p in t.Members)
                                {
                                    <li>
                                        <a asp-page="/UserProfile" asp-route-id="@p.Id" class="user-link">
                                            @p.Username
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p style="color:gray; font-style:italic;">No members yet.</p>
                        }
                    </div>

                    <div class="mt-3">
                        @if (Model.MyTeam == null)
                        {
                            if (!Model.PendingRequests.Contains(t.Id))
                            {
                                <form method="post" asp-page-handler="Join">
                                    <input type="hidden" name="teamId" value="@t.Id" />
                                    <button class="btn btn-primary btn-sm">Join Team</button>
                                </form>
                            }
                            else
                            {
                                <span style="color:#aaa;">Request sent...</span>
                            }
                        }
                    </div>

                </div>
            </div>
        }
    </div>
</div>

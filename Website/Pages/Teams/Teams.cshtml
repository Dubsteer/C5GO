@page "/Teams/Teams"
@model Website.Pages.Teams.TeamsModel
@{
    ViewData["Title"] = "Teams";
}

<section aria-labelledby="teamsTitle">
    <header class="page-header page-header-centered">
        <h1 id="teamsTitle" class="page-title">Teams</h1>
        <p class="page-subtitle">Find a team, review its roster or create your own.</p>
    </header>

    <div class="filter-bar" role="group" aria-label="Filter teams">
        <button type="button" class="filter-btn active" data-team-filter="all" aria-pressed="true">All teams</button>
        <button type="button" class="filter-btn" data-team-filter="open" aria-pressed="false">Open teams</button>
        <button type="button" class="filter-btn" data-team-filter="full" aria-pressed="false">Full teams</button>
    </div>

    @if (Model.MyTeam == null)
    {
        <div class="create-team-box">
            <h2 class="section-heading">You don't have a team yet</h2>
            <p>Create a team and invite players, or request to join an open team.</p>
            <a asp-page="/Teams/Create" class="btn btn-success">Create team</a>
        </div>
    }

    @if (Model.AllTeams.Count == 0)
    {
        <div class="page-empty-state">
            <strong>No teams yet</strong>
            <span>Create the first team in the community.</span>
        </div>
    }
    else
    {
        <div class="team-grid" id="teamsContainer">
            @foreach (var team in Model.AllTeams)
            {
                var isMyTeam = Model.MyTeam?.Id == team.Id;
                var isFull = team.Members.Count >= 5;

                <article class="team-item" data-status="@(isFull ? "full" : "open")">
                    <div class="team-card @(isMyTeam ? "my-team" : string.Empty)">
                        <a class="full-link" asp-page="/Teams/Details" asp-route-id="@team.Id">
                            <span class="visually-hidden">View @team.Name</span>
                        </a>

                        @if (isMyTeam)
                        {
                            <span class="my-team-badge">My team</span>
                        }

                        <h2>@team.Name</h2>
                        <p>
                            <strong>Captain:</strong>
                            <a asp-page="/UserProfile" asp-route-id="@team.Captain.Id" class="user-link">@team.Captain.Username</a>
                        </p>
                        <p><strong>Members:</strong> @team.Members.Count / 5</p>

                        <div class="team-actions">
                            @if (isMyTeam)
                            {
                                <a asp-page="/Teams/Details" asp-route-id="@team.Id" class="btn btn-success btn-sm">View team</a>
                            }
                            else if (isFull)
                            {
                                <span class="team-status-text team-status-full">Team is full</span>
                            }
                            else if (Model.MyTeam == null && !Model.PendingRequests.Contains(team.Id))
                            {
                                if (string.IsNullOrWhiteSpace(Model.CurrentUser.SteamId) || Model.CurrentUser.SteamId == "0")
                                {
                                    <button type="button" class="btn btn-secondary btn-sm btn-disabled" onclick="requireSteamId()">Request to join</button>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Join">
                                        <input type="hidden" name="teamId" value="@team.Id" />
                                        <button class="btn btn-primary btn-sm" type="submit">Request to join</button>
                                    </form>
                                }
                            }
                            else if (Model.PendingRequests.Contains(team.Id))
                            {
                                <span class="team-status-text">Request pending</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<div class="toast-container">
    <div id="appToast" class="toast align-items-center" role="status" aria-live="polite">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close notification"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showToast(message, type) {
            const toastElement = document.getElementById("appToast");
            const toastBody = document.getElementById("toastMessage");
            toastElement.classList.remove("toast-success", "toast-warning");
            toastElement.classList.add(type === "success" ? "toast-success" : "toast-warning");
            toastBody.textContent = message;
            new bootstrap.Toast(toastElement, { delay: 3000 }).show();
        }

        function requireSteamId() {
            showToast("Add your Steam ID in your profile before requesting to join a team.", "warning");
        }

        document.querySelectorAll("[data-team-filter]").forEach((button) => {
            button.addEventListener("click", () => {
                const filter = button.dataset.teamFilter;
                document.querySelectorAll("[data-team-filter]").forEach((item) => {
                    const isActive = item === button;
                    item.classList.toggle("active", isActive);
                    item.setAttribute("aria-pressed", String(isActive));
                });

                document.querySelectorAll(".team-item").forEach((card) => {
                    card.hidden = filter !== "all" && card.dataset.status !== filter;
                });
            });
        });
    </script>

    @if (TempData["Error"] is string errorMessage)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)), "warning");
            });
        </script>
    }

    @if (TempData["Message"] is string successMessage)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)), "success");
            });
        </script>
    }
}

@page "/Teams/Teams"
@model Website.Pages.Teams.TeamsModel
@{
    ViewData["Title"] = "Teams";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #0d1117;
        color: #f0f0f0;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    h1 {
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .team-card {
        background: #161b22;
        border-radius: 12px;
        padding: 22px;
        border: 1px solid #2d333b;
        transition: 0.2s;
        min-height: 220px;
        position: relative;
    }

        .team-card:hover {
            border-color: #6366f1;
            box-shadow: 0 0 10px rgba(99,102,241,0.4);
        }

    .full-link {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .user-link {
        color: #58a6ff !important;
        font-weight: 600;
        text-decoration: none;
        position: relative;
        z-index: 2;
    }

    .team-actions {
        position: relative;
        z-index: 2;
        margin-top: 12px;
    }
</style>

<div class="container mt-5">

    <h1 class="text-center">Teams</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Message"]</div>
    }

    <div class="row g-4">
        @foreach (var t in Model.AllTeams)
        {
            <div class="col-lg-4 col-md-6">
                <div class="team-card">

                    <a class="full-link"
                       asp-page="/Teams/Details"
                       asp-route-id="@t.Id"></a>

                    <h3>@t.Name</h3>

                    <p>
                        <strong>Captain:</strong>
                        <a asp-page="/UserProfile"
                           asp-route-id="@t.Captain.Id"
                           class="user-link">
                            @t.Captain.Username
                        </a>
                    </p>

                    <p><strong>Members:</strong> @t.Members.Count / 5</p>

                    <div class="team-actions">
                        @if (Model.MyTeam == null && !Model.PendingRequests.Contains(t.Id))
                        {
                            <form method="post" asp-page-handler="Join">
                                <input type="hidden" name="teamId" value="@t.Id" />
                                <button class="btn btn-primary btn-sm">Join Team</button>
                            </form>
                        }
                        else if (Model.PendingRequests.Contains(t.Id))
                        {
                            <span style="color:#aaa;">Request sent…</span>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
</div>

@page
@model Website.Pages.TournamentsModel
@{
    ViewData["Title"] = "Tournaments";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #0d1117;
        color: #f0f0f0;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    h1 {
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 25px;
    }

    /* FILTER BUTTONS */
    .filter-btn {
        background: #21262d;
        border: 1px solid #30363d;
        color: white;
        padding: 8px 18px;
        border-radius: 10px;
        font-weight: 600;
    }

        .filter-btn.active {
            background: #238636;
            border-color: #2ea043;
        }

    /* CARD */
    .tournament-card {
        background: #161b22;
        border-radius: 12px;
        padding: 22px;
        border: 1px solid #2d333b;
        transition: transform .20s ease, box-shadow .20s ease;
        min-height: 260px;
    }

    a .tournament-card:hover {
        transform: scale(1.03);
        box-shadow: 0px 0px 10px rgba(99, 102, 241, 0.4);
        border-color: #6366f1;
    }

    a {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .clickable-card {
        cursor: pointer;
    }

    /* BADGES */
    .badge-open {
        background-color: #22c55e !important;
        font-size: 14px;
        padding: 6px 10px;
        border-radius: 8px;
    }

    .badge-progress {
        background-color: #facc15 !important;
        color: #000;
        font-size: 14px;
        padding: 6px 10px;
        border-radius: 8px;
    }

    .badge-closed {
        background-color: #ef4444 !important;
        font-size: 14px;
        padding: 6px 10px;
        border-radius: 8px;
    }

    .badge-team {
        background-color: #3b82f6 !important;
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 6px;
        margin-left: 6px;
    }

    .badge-solo {
        background-color: #a855f7 !important;
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 6px;
        margin-left: 6px;
    }
</style>

<div class="container mt-5">

    <h1 class="text-center mb-4" style="color:#000; font-weight:900; font-size:36px;">
        Tournaments
    </h1>

    <!-- FILTER BAR -->
    <form method="get" class="text-center mb-4">
        <button name="filter" value="all" class="filter-btn @(Model.Filter == "all" ? "active" : "")">All</button>
        <button name="filter" value="solo" class="filter-btn @(Model.Filter == "solo" ? "active" : "")">Solo</button>
        <button name="filter" value="team" class="filter-btn @(Model.Filter == "team" ? "active" : "")">Team</button>
    </form>

    <!-- ALERT -->
    @if (!Model.IsPlayer)
    {
        <div class="alert alert-warning text-center">
            Add your SteamID in your <a asp-page="/ViewProfile">Profile</a> first to join tournaments.
        </div>
    }

    <div class="row g-4">
        @foreach (var t in Model.Tournaments)
        {
            <div class="col-md-4">

                <!-- WRAP WHOLE CARD INSIDE <a> -->
                <a asp-page="/Tournaments/Details" asp-route-id="@t.Id">
                    <div class="tournament-card clickable-card">

                        <h3>
                            @t.Name

                            @if (t.IsTeamTournament)
                            {
                                <span class="badge-team">Team @t.TeamSizeRequired v @t.TeamSizeRequired</span>
                            }
                            else
                            {
                                <span class="badge-solo">Solo</span>
                            }
                        </h3>

                        <p>@t.Description</p>

                        @switch (t.Status)
                        {
                            case LogicLayer.Enums.Status.Open:
                                <span class="badge badge-open">OPEN</span>
                                break;
                            case LogicLayer.Enums.Status.InProgress:
                                <span class="badge badge-progress">IN PROGRESS</span>
                                break;
                            case LogicLayer.Enums.Status.Closed:
                                <span class="badge badge-closed">CLOSED</span>
                                break;
                        }

                        <hr />

                        <p><strong>@(t.IsTeamTournament ? "Teams" : "Players"):</strong> @t.Players.Count</p>

                        <p><strong>Matches:</strong> @t.Matches.Count</p>

                        <hr />

                        <!-- ACTION BUTTONS -->
                        <div class="d-flex flex-wrap gap-2">

                            <!-- SOLO JOIN -->
                            @if (!t.IsTeamTournament
                                                    && Model.IsPlayer
                                                    && t.Status == LogicLayer.Enums.Status.Open
                                                    && !t.Players.Any(p => p.Id == Model.CurrentPlayer.Id))
                            {
                                <form method="post" asp-page-handler="ApplySolo" onclick="event.stopPropagation();">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-success btn-sm">Join</button>
                                </form>
                            }

                            <!-- TEAM JOIN -->
                            @if (t.IsTeamTournament
                                                    && Model.MyTeam != null
                                                    && Model.MyTeam.Captain.Id == Model.CurrentPlayer.Id
                                                    && Model.MyTeam.Members.Count == t.TeamSizeRequired
                                                    && t.Status == LogicLayer.Enums.Status.Open
                                                    && !t.Players.Any(x => x.Id == Model.CurrentPlayer.Id))
                            {
                                <form method="post" asp-page-handler="ApplyTeam" onclick="event.stopPropagation();">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-info btn-sm">Join (Team)</button>
                                </form>
                            }

                            <!-- LEAVE -->
                            @if (Model.IsPlayer
                                                    && t.Players.Any(p => p.Id == Model.CurrentPlayer.Id))
                            {
                                <form method="post" asp-page-handler="Leave" onclick="event.stopPropagation();">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-warning btn-sm">Leave</button>
                                </form>
                            }

                            <!-- ADMIN -->
                            @if (Model.IsPlayer && Model.CurrentPlayer.IsAdmin)
                            {
                                @if (t.Status != LogicLayer.Enums.Status.Closed)
                                {
                                    <form method="post" asp-page-handler="Close" onclick="event.stopPropagation();">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button class="btn btn-danger btn-sm">Close</button>
                                    </form>
                                }

                                <form method="post" asp-page-handler="Delete" onclick="event.stopPropagation();">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            }

                        </div>

                    </div>
                </a>

            </div>
        }
    </div>
</div>

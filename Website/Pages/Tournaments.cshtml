@page
@using LogicLayer.Models;
@model TournamentsModel

<style>
    .container {
        text-align: center;
    }

    h1 {
        color: #fff;
        font-family: '5';
        margin-top: 20px;
    }

    hr {
        border-color: #fff;
        margin-top: 10px;
        margin-bottom: 10px;
    }

    p, td {
        color: #fff;
    }

    .apply-button {
        margin-top: 10px;
    }

        .apply-button button {
            background-color: greenyellow;
            color: #black;
            border: none;
            padding: 8px 16px;
            font-size: 14px;
            cursor: pointer;
        }

    .disabled-button {
        margin-top: 10px;
        color: #ccc;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        color: #fff;
    }

    th, td {
        border: 1px solid #ddd;
        padding: 15px;
        text-align: left;
    }

    th {
        background-color: #4CAF50;
        color: white;
    }
</style>

<div class="container">
    @foreach (var tournament in Model.Tournaments)
    {
        <h1>
            @tournament.Name
        </h1>
        <hr />

        <table>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Players</th>
                <th>Matches</th>
            </tr>
            <tr>
                <td>@tournament.Name</td>
                <td>@tournament.Description</td>
                <td>
                    @if (tournament.Players == null || tournament.Players.Count == 0)
                    {
                        <p>There are no players registered yet.</p>
                    }
                    else
                    {
                        foreach (var player in tournament.Players)
                        {
                            <p>@player.Username</p>
                        }
                    }
                </td>
                <td>
                    @if (tournament.Matches == null || tournament.Matches.Count == 0)
                    {
                        <p>There are no matches yet.</p>
                    }
                    else
                    {
                        foreach (var match in tournament.Matches)
                        {
                            <div class="match-divider">
                                <p>Match: @match.Id between @match.User1 and @match.User2, <span class="score">Score: @match.Player1Score - @match.Player2Score</span></p>
                            </div>
                        }
                    }
                </td>
            </tr>
        </table>

        @if (!tournament.Closed && (tournament.Players != null && tournament.Players.Count < 10))
        {
            if (!Model.checkIfPlayerInTournament(tournament.Id))
            {
                <div class="apply-button">
                    <form method="post" asp-page-handler="Apply" asp-route-id="@tournament.Id">
                        <button type="submit">Apply</button>
                    </form>
                </div>
            }
            else
            {
                <p class="disabled-button">You can't apply for this tournament.</p>
            }
        }
        else
        {
            <p class="disabled-button">You can't apply for this tournament.</p>
        }
    }
    <div style="height: 80px; width: 2px"></div>
</div>
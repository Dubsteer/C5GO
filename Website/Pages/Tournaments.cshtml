@page
@model Website.Pages.TournamentsModel
@{
    ViewData["Title"] = "Tournaments";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #0d1117;
        color: white;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    .card-box {
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 0 6px rgba(0,0,0,0.25);
        transition: 0.2s;
        cursor: pointer;
        position: relative;
    }

    .card-box:hover {
        transform: scale(1.02);
        border-color: #4da3ff;
    }

    .full-link {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .btn-small {
        padding: 6px 12px;
        margin-right: 5px;
        position: relative;
        z-index: 5;
    }

    .tag {
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 6px;
        font-weight: bold;
    }

    .tag-solo { background: #8b5cf6; color: white; }
    .tag-team { background: #3b82f6; color: white; }

    .tag-status-open { background: #22c55e; color: black; }
    .tag-status-running { background: #eab308; color: black; }
    .tag-status-closed { background: #ef4444; color: white; }
</style>

<div class="container mt-4">

    <h1 class="text-center mb-4">Tournaments</h1>

    <!-- FILTER -->
    <div class="text-center mb-4">

        <a href="/Tournaments?filter=all"
           class="btn btn-small @(Model.Filter == "all" ? "btn-success" : "btn-secondary")">
            All
        </a>

        <a href="/Tournaments?filter=solo"
           class="btn btn-small @(Model.Filter == "solo" ? "btn-success" : "btn-secondary")">
            Solo
        </a>

        <a href="/Tournaments?filter=team"
           class="btn btn-small @(Model.Filter == "team" ? "btn-success" : "btn-secondary")">
            Team
        </a>
    </div>

    <div class="row">
        @foreach (var t in Model.Tournaments)
        {
            <div class="col-md-4">
                <div class="card-box">

                    <a class="full-link" href="/Tournaments/Details/@t.Id"></a>

                    <h3>@t.Name</h3>
                    <p>@t.Description</p>

                    <!-- TYPE TAG -->
                    @if (t.IsTeamTournament)
                    {
                        <span class="tag tag-team">Team @t.TeamSizeRequired v @t.TeamSizeRequired</span>
                    }
                    else
                    {
                        <span class="tag tag-solo">Solo</span>
                    }

                    <!-- STATUS TAG -->
                    <div class="mt-2">
                        @if (t.Status == LogicLayer.Enums.Status.Open)
                        {
                            <span class="tag tag-status-open">OPEN</span>
                        }
                        else if (t.Status == LogicLayer.Enums.Status.InProgress)
                        {
                            <span class="tag tag-status-running">IN PROGRESS</span>
                        }
                        else
                        {
                            <span class="tag tag-status-closed">CLOSED</span>
                        }
                    </div>

                    <!-- INFO -->
                    <div class="mt-3">
                        @if (!t.IsTeamTournament)
                        {
                            <b>Players:</b> @t.PlayersCount <br />
                            <b>Matches:</b> @t.MatchesCount
                        }
                        else
                        {
                            <b>Teams:</b> @t.TeamsCount <br />
                            <b>Matches:</b> @t.MatchesCount
                        }
                    </div>

                    <!-- BUTTONS -->
                    <div class="mt-3">

                        <!-- LEAVE -->
                        @if (t.CanLeave)
                        {
                            if (!t.IsTeamTournament)
                            {
                                <form method="post" asp-page-handler="Leave" asp-route-id="@t.Id" style="display:inline;">
                                    <button type="submit" class="btn btn-warning btn-small">Leave</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="LeaveTeam" asp-route-id="@t.Id" style="display:inline;">
                                    <button type="submit" class="btn btn-warning btn-small">Leave Team</button>
                                </form>
                            }
                        }
                        else
                        {
                            <!-- JOIN -->
                            if (t.Status == LogicLayer.Enums.Status.Open)
                            {
                                if (!t.IsTeamTournament)
                                {
                                    <form method="post" asp-page-handler="ApplySolo" asp-route-id="@t.Id" style="display:inline;">
                                        <button type="submit" class="btn btn-success btn-small">Join</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="ApplyTeam" asp-route-id="@t.Id" style="display:inline;">
                                        <button type="submit" class="btn btn-success btn-small">Join (Team)</button>
                                    </form>
                                }
                            }
                        }

                        <!-- ADMIN DELETE -->
                        @if (Model.IsAdmin)
                        {
                            <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" style="display:inline;">
                                <button class="btn btn-danger btn-small">Delete</button>
                            </form>
                        }

                    </div>
                </div>
            </div>
        }
    </div>
</div>

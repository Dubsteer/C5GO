@page
@model Website.Pages.TournamentsModel
@{
    ViewData["Title"] = "Tournaments";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #121212;
        color: white;
    }

    .tournament-card {
        background-color: #1e1e1e;
        border-radius: 10px;
        padding: 20px;
        border: 1px solid #333;
        transition: 0.2s;
        color: #fff !important; /* <<<<<< OVDE JE GLAVNI FIX ZA VIDLJIV TEKST */
    }

        .tournament-card h3,
        .tournament-card p,
        .tournament-card span,
        .tournament-card strong {
            color: #fff !important; /* Osigurano da SVE ostane belo */
        }

        .tournament-card:hover {
            border-color: #6f42c1;
            transform: scale(1.01);
        }

    .badge-open {
        background-color: #28a745;
    }

    .badge-progress {
        background-color: #ffc107;
        color: black;
    }

    .badge-closed {
        background-color: #dc3545;
    }
</style>

<div class="container mt-5">

    <h1 class="mb-4 text-center">🏆 Tournaments</h1>

    @if (Model.Tournaments == null || Model.Tournaments.Count == 0)
    {
        <p class="text-center text-muted">No tournaments available.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var t in Model.Tournaments)
            {
                <div class="col-md-4">
                    <div class="tournament-card">

                        <h3>@t.Name</h3>
                        <p>@t.Description</p>

                        <!-- STATUS -->
                        @switch (t.Status)
                        {
                            case LogicLayer.Enums.Status.Open:
                                <span class="badge badge-open">OPEN</span>
                                break;

                            case LogicLayer.Enums.Status.InProgress:
                                <span class="badge badge-progress">IN PROGRESS</span>
                                break;

                            case LogicLayer.Enums.Status.Closed:
                                <span class="badge badge-closed">CLOSED</span>
                                break;
                        }

                        <hr />

                        <p><strong>Players:</strong> @t.Players.Count</p>
                        <p><strong>Matches:</strong> @t.Matches.Count</p>

                        <hr />

                        <!-- USER ACTIONS -->
                        <div class="d-flex flex-wrap gap-2">

                            @* JOIN *@
                            @if (!t.Players.Any(p => p.Id == Model.CurrentPlayer.Id) &&
                                                t.Status == LogicLayer.Enums.Status.Open)
                            {
                                <form method="post" asp-page-handler="Apply">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-success btn-sm">Join</button>
                                </form>
                            }

                            @* LEAVE *@
                            @if (t.Players.Any(p => p.Id == Model.CurrentPlayer.Id))
                            {
                                <form method="post" asp-page-handler="Leave">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-warning btn-sm">Leave</button>
                                </form>
                            }

                            @* ADMIN ONLY *@
                            @if (Model.CurrentPlayer.IsAdmin)
                            {
                                @* CLOSE *@
                                @if (t.Status != LogicLayer.Enums.Status.Closed)
                                {
                                    <form method="post" asp-page-handler="Close">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button class="btn btn-danger btn-sm">Close</button>
                                    </form>
                                }

                                @* DELETE *@
                                <form method="post" asp-page-handler="Delete">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            }

                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

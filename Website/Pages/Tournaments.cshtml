@page
@model Website.Pages.TournamentsModel
@{
    ViewData["Title"] = "Tournaments";
}

<section aria-labelledby="tournamentsTitle">
    <header class="page-header page-header-centered">
        <h1 id="tournamentsTitle" class="page-title">Tournaments</h1>
        <p class="page-subtitle">Join solo competitions or register your full team.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success" role="status">@Model.Message</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    <nav class="filter-bar" aria-label="Filter tournaments">
        <a asp-page="/Tournaments" asp-route-filter="all" class="filter-btn @(Model.Filter == "all" ? "active" : string.Empty)" aria-current="@(Model.Filter == "all" ? "page" : null)">All</a>
        <a asp-page="/Tournaments" asp-route-filter="solo" class="filter-btn @(Model.Filter == "solo" ? "active" : string.Empty)" aria-current="@(Model.Filter == "solo" ? "page" : null)">Solo</a>
        <a asp-page="/Tournaments" asp-route-filter="team" class="filter-btn @(Model.Filter == "team" ? "active" : string.Empty)" aria-current="@(Model.Filter == "team" ? "page" : null)">Team</a>
    </nav>

    @if (Model.Tournaments.Count == 0)
    {
        <div class="page-empty-state">
            <strong>No tournaments found</strong>
            <span>Try another filter or check again later.</span>
        </div>
    }
    else
    {
        <div class="tournament-grid">
            @foreach (var tournament in Model.Tournaments)
            {
                <article class="tournament-item">
                    <div class="card-box">
                        <a class="full-link" asp-page="/Tournaments/Details" asp-route-id="@tournament.Id">
                            <span class="visually-hidden">View @tournament.Name</span>
                        </a>

                        <h2>@tournament.Name</h2>
                        <p class="t-desc">@tournament.Description</p>

                        <div class="tag-row">
                            <span class="tag @(tournament.IsTeamTournament ? "tag-team" : "tag-solo")">
                                @(tournament.IsTeamTournament ? $"Team {tournament.TeamSizeRequired}v{tournament.TeamSizeRequired}" : "Solo")
                            </span>
                            <span class="tag @(tournament.Status == LogicLayer.Enums.Status.Open ? "tag-status-open" : tournament.Status == LogicLayer.Enums.Status.InProgress ? "tag-status-running" : "tag-status-closed")">
                                @(tournament.Status == LogicLayer.Enums.Status.InProgress ? "In progress" : tournament.Status.ToString())
                            </span>
                        </div>

                        <div class="tournament-metrics">
                            <span>@(tournament.IsTeamTournament ? $"{tournament.TeamsCount} teams" : $"{tournament.PlayersCount} players")</span>
                            <span>@tournament.MatchesCount matches</span>
                        </div>

                        <div class="card-actions">
                            @if (tournament.CanLeave)
                            {
                                <form method="post" asp-page-handler="Leave" asp-route-id="@tournament.Id">
                                    <button type="submit" class="btn btn-outline-warning btn-sm">Leave</button>
                                </form>
                            }
                            else if (tournament.Status == LogicLayer.Enums.Status.Open)
                            {
                                <form method="post" asp-page-handler="@(tournament.IsTeamTournament ? "ApplyTeam" : "ApplySolo")" asp-route-id="@tournament.Id">
                                    <button type="submit" class="btn btn-success btn-sm">@(tournament.IsTeamTournament ? "Register team" : "Join")</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

@page "{id:int}"
@model Website.Pages.Tournaments.DetailsModel

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #121212;
        color: white;
        font-family: Arial, sans-serif;
    }

    .section-card {
        background: #1e1e1e;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 30px;
        border: 1px solid #2e2e2e;
    }

    .section-title {
        font-size: 22px;
        font-weight: bold;
        color: #90EE90;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
    }

    .section-description-text {
        color: #d7d7d7 !important;
        font-size: 16px;
    }

    .player-item {
        color: #ffffff !important;
        font-size: 16px;
        margin-left: 10px;
    }

    .back-btn {
        background: #4da3ff;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
    }

        .back-btn:hover {
            background: #7cc2ff;
        }

    .muted {
        color: #9e9e9e !important;
        font-style: italic;
    }
</style>

<div class="container mt-4">

    <h1 class="text-center mb-4">
        🎯 @Model.Tournament.Name
    </h1>

    <!-- DESCRIPTION -->
    <div class="section-card">
        <div class="section-title">
            🔷 Description
        </div>

        <p class="section-description-text">
            @Model.Tournament.Description
        </p>
    </div>

    <!-- PLAYERS -->
    <div class="section-card">
        <div class="section-title">
            🧍 Players (@Model.Tournament.Players.Count)
        </div>

        @if (Model.Tournament.Players.Count == 0)
        {
            <p class="muted">No players registered yet.</p>
        }
        else
        {
            <ul>
                @foreach (var p in Model.Tournament.Players)
                {
                    <li class="player-item">@p.Username</li>
                }
            </ul>
        }
    </div>

    <!-- MATCHES -->
    <div class="section-card">
        <div class="section-title">
            ⚔ Matches (@Model.Tournament.Matches.Count)
        </div>

        @if (Model.Tournament.Matches.Count == 0)
        {
            <p class="muted">No matches created yet.</p>
        }
        else
        {
            <!-- ready for future matches UI -->
        }
    </div>

    <a href="/Tournaments" class="back-btn">⬅ Back to Tournaments</a>

</div>

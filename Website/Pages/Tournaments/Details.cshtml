@page "{id:int}"
@model Website.Pages.Tournaments.DetailsModel
@{
    ViewData["Title"] = "Tournament details";
}

<article class="tournament-details">
    <header class="tournament-details-header">
        <a asp-page="/Tournaments" class="back-link">&larr; Back to tournaments</a>
        <h1 class="tournament-details-title">@Model.Tournament.Name</h1>
        <p class="tournament-details-description">@Model.Tournament.Description</p>
        <span class="tag @(Model.Tournament.IsTeamTournament ? "tag-team" : "tag-solo")">
            @(Model.Tournament.IsTeamTournament ? "Team tournament" : "Solo tournament")
        </span>
    </header>

    @if (Model.Tournament.IsTeamTournament)
    {
        <section class="tournament-section" aria-labelledby="registeredTeamsTitle">
            <h2 id="registeredTeamsTitle" class="tournament-section-title">Registered teams (@Model.TeamsById.Count)</h2>
            @if (!Model.TeamsById.Any())
            {
                <div class="empty-state"><strong>No teams registered</strong><span>Registered teams will appear here.</span></div>
            }
            else
            {
                foreach (var team in Model.TeamsById.Values)
                {
                    <div class="team-list-box">
                        <strong>@team.Name</strong>
                        <div class="text-secondary">Captain: @team.Captain.Username</div>
                        <div class="text-secondary small">Members: @string.Join(", ", team.Members.Select(member => member.Username))</div>
                    </div>
                }
            }
        </section>

        <section class="tournament-section" aria-labelledby="teamMatchesTitle">
            <h2 id="teamMatchesTitle" class="tournament-section-title">Team matches</h2>
            @if (!Model.TeamMatches.Any())
            {
                <div class="empty-state"><strong>No matches scheduled</strong><span>Matches will appear after the bracket is generated.</span></div>
            }
            else
            {
                foreach (var match in Model.TeamMatches)
                {
                    var teamOne = Model.TeamsById.TryGetValue(match.Team1Id, out var firstTeam) ? firstTeam.Name : $"Team {match.Team1Id}";
                    var teamTwo = Model.TeamsById.TryGetValue(match.Team2Id, out var secondTeam) ? secondTeam.Name : $"Team {match.Team2Id}";

                    <div class="match-box">
                        <div class="team-row @(match.Team1Score < match.Team2Score ? "loser" : string.Empty)">
                            <div class="d-flex justify-content-between gap-3"><span>@teamOne</span><span class="score">@match.Team1Score</span></div>
                        </div>
                        <div class="team-row @(match.Team2Score < match.Team1Score ? "loser" : string.Empty)">
                            <div class="d-flex justify-content-between gap-3"><span>@teamTwo</span><span class="score">@match.Team2Score</span></div>
                        </div>
                        <time class="text-secondary small" datetime="@match.MatchDate.ToString("O")">@match.MatchDate.ToString("dd.MM.yyyy HH:mm")</time>
                    </div>
                }
            }
        </section>
    }
    else
    {
        <section class="tournament-section" aria-labelledby="soloMatchesTitle">
            <h2 id="soloMatchesTitle" class="tournament-section-title">Matches</h2>
            @if (!Model.SoloMatches.Any())
            {
                <div class="empty-state"><strong>No matches generated</strong><span>Matches will appear after the bracket is generated.</span></div>
            }
            else
            {
                foreach (var match in Model.SoloMatches)
                {
                    <div class="match-box">
                        <div class="team-row @(match.Player1Score < match.Player2Score ? "loser" : string.Empty)">
                            <div class="d-flex justify-content-between gap-3"><span>@match.User1.Username</span><span class="score">@match.Player1Score</span></div>
                        </div>
                        <div class="team-row @(match.Player2Score < match.Player1Score ? "loser" : string.Empty)">
                            <div class="d-flex justify-content-between gap-3"><span>@match.User2.Username</span><span class="score">@match.Player2Score</span></div>
                        </div>
                        <time class="text-secondary small" datetime="@match.MatchDate.ToString("O")">@match.MatchDate.ToString("dd.MM.yyyy HH:mm")</time>
                    </div>
                }
            }
        </section>

        <section class="tournament-section" aria-labelledby="playersTitle">
            <h2 id="playersTitle" class="tournament-section-title">Players (@Model.SoloPlayers.Count)</h2>
            @if (!Model.SoloPlayers.Any())
            {
                <div class="empty-state"><strong>No players joined</strong><span>Registered players will appear here.</span></div>
            }
            else
            {
                <div class="participant-list">
                    @foreach (var player in Model.SoloPlayers)
                    {
                        <div class="participant-item">@player.Username</div>
                    }
                </div>
            }
        </section>
    }
</article>

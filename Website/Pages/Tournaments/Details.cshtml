@page "{id:int}"
@model Website.Pages.Tournaments.DetailsModel

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />

<style>

    body {
        background-color: #0d1117;
        color: white;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    .bracket-container {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-top: 40px;
        overflow-x: auto;
        padding-bottom: 40px;
    }

    .round-column {
        width: 260px;
    }

    .round-title {
        text-align: center;
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 15px;
        color: #58a6ff;
    }

    .match-box {
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 25px;
        position: relative;
        box-shadow: 0 0 6px rgba(0,0,0,0.25);
    }

    .team-row {
        display: flex;
        justify-content: space-between;
        padding: 4px 0;
        font-size: 16px;
    }

    .team-name {
        color: #fff;
    }

    .loser {
        opacity: 0.45;
    }

    .score {
        font-weight: 700;
        color: #a5b4fc;
    }

    .back-btn {
        background: #4da3ff;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
    }

        .back-btn:hover {
            background: #7cc2ff;
        }

</style>

<div class="container mt-4">

    <h1 class="text-center mb-4" style="font-weight:900; font-size:36px;">
        🏆 @Model.Tournament.Name
    </h1>

    <p class="text-center">@Model.Tournament.Description</p>

    <hr style="border-color:#2d333b" />

    <h2 class="text-center mt-4" style="color:#a5b4fc;">Tournament Bracket</h2>

    <!-- BRACKET -->
    <div class="bracket-container">

        <!-- ROUND 1 -->
        <div class="round-column">
            <div class="round-title">Quarter-finals</div>

            @if (Model.Round1.Count == 0)
            {
                <p style="text-align:center; color:gray;">No matches</p>
            }
            else
            {
                @foreach (var m in Model.Round1)
                {
                    <div class="match-box">
                        <div class="team-row @(m.Player1Score < m.Player2Score ? "loser" : "")">
                            <span class="team-name">@m.User1.Username</span>
                            <span class="score">@m.Player1Score</span>
                        </div>

                        <div class="team-row @(m.Player2Score < m.Player1Score ? "loser" : "")">
                            <span class="team-name">@m.User2.Username</span>
                            <span class="score">@m.Player2Score</span>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- ROUND 2 -->
        <div class="round-column">
            <div class="round-title">Semi-finals</div>

            @if (Model.Round2.Count == 0)
            {
                <p style="text-align:center; color:gray;">No matches</p>
            }
            else
            {
                @foreach (var m in Model.Round2)
                {
                    <div class="match-box">
                        <div class="team-row @(m.Player1Score < m.Player2Score ? "loser" : "")">
                            <span class="team-name">@m.User1.Username</span>
                            <span class="score">@m.Player1Score</span>
                        </div>

                        <div class="team-row @(m.Player2Score < m.Player1Score ? "loser" : "")">
                            <span class="team-name">@m.User2.Username</span>
                            <span class="score">@m.Player2Score</span>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- FINAL -->
        <div class="round-column">
            <div class="round-title">Grand Final</div>

            @if (Model.Round3.Count == 0)
            {
                <p style="text-align:center; color:gray;">No final match</p>
            }
            else
            {
                var finalMatch = Model.Round3.First();

                <div class="match-box">
                    <div class="team-row @(finalMatch.Player1Score < finalMatch.Player2Score ? "loser" : "")">
                        <span class="team-name">@finalMatch.User1.Username</span>
                        <span class="score">@finalMatch.Player1Score</span>
                    </div>

                    <div class="team-row @(finalMatch.Player2Score < finalMatch.Player1Score ? "loser" : "")">
                        <span class="team-name">@finalMatch.User2.Username</span>
                        <span class="score">@finalMatch.Player2Score</span>
                    </div>
                </div>
            }
        </div>

    </div>

    <div class="text-center mt-4">
        <a href="/Tournaments" class="back-btn">⬅ Back to Tournaments</a>
    </div>

</div>

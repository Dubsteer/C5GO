@page "{id:int}"
@model Website.Pages.UserProfileModel
@{
    ViewData["Title"] = "User profile";
    Layout = "_ProfileLayout";
}

<div class="profile-actions">
    <div><span class="profile-label">Username</span><div class="profile-username">@Model.ViewedUser.Username</div></div>
    <span class="tag @(Model.ViewedUser.IsAdmin ? "tag-status-running" : "tag-solo")">
        @(Model.ViewedUser.IsAdmin ? "Administrator" : Model.ViewedPlayer != null ? "Player" : "Member")
    </span>
</div>

<div class="profile-info-grid">
    <div class="profile-info-item"><span class="profile-label">First name</span><div class="profile-value">@Model.ViewedUser.Firstname</div></div>
    <div class="profile-info-item"><span class="profile-label">Last name</span><div class="profile-value">@Model.ViewedUser.Lastname</div></div>
    <div class="profile-info-item"><span class="profile-label">Email</span><div class="profile-value">@Model.ViewedUser.Gmail</div></div>
    <div class="profile-info-item"><span class="profile-label">Birthday</span><div class="profile-value">@(Model.ViewedUser.Birthday?.ToString("dd.MM.yyyy") ?? "Not provided")</div></div>
    <div class="profile-info-item profile-info-wide"><span class="profile-label">Steam ID</span><div class="profile-value">@(Model.ViewedPlayer?.SteamId ?? "No player profile")</div></div>
</div>

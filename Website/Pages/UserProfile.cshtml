@page "{id:int}"
@model Website.Pages.UserProfileModel
@{
    ViewData["Title"] = "Profile";
    Layout = "_ProfileLayout";
}

<div>

    <h3 class="profile-value">@Model.ViewedUser.Username</h3>

    <div>
        <span class="profile-label">First Name</span>
        <div class="profile-value">@Model.ViewedUser.Firstname</div>

        <span class="profile-label">Last Name</span>
        <div class="profile-value">@Model.ViewedUser.Lastname</div>

        <span class="profile-label">Email</span>
        <div class="profile-value">@Model.ViewedUser.Gmail</div>

        <span class="profile-label">Birthday</span>
        <div class="profile-value">
            @(Model.ViewedUser.Birthday?.ToString("yyyy-MM-dd") ?? "N/A")
        </div>

        <span class="profile-label">Steam ID</span>
        <div class="profile-value">
            @(Model.ViewedPlayer?.SteamId ?? "N/A")
        </div>

        <span class="profile-label">Role</span>
        <div class="profile-value">
            @(Model.ViewedUser.IsAdmin ? "Admin" : "Player")
        </div>
    </div>

</div>

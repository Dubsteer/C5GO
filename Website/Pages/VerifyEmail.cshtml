@page
@model Website.Pages.VerifyEmailModel
@{
    ViewData["Title"] = "Verify email";
}

<section class="status-container" aria-labelledby="verificationTitle">
    <div class="status-card">
        @if (Model.IsSuccess)
        {
            <div class="status-icon" aria-hidden="true">&#10003;</div>
            <h1 id="verificationTitle">Email verified</h1>
            <p>@Model.Message</p>
            <a asp-page="/Login" class="btn btn-primary">Go to login</a>
        }
        else
        {
            <div class="status-icon status-icon-error" aria-hidden="true">!</div>
            <h1 id="verificationTitle">Verification failed</h1>
            <p>@Model.Message</p>
            <a asp-page="/Register" class="btn btn-primary">Back to registration</a>
        }
    </div>
</section>

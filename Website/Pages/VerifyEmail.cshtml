@page
@model Website.Pages.VerifyEmailModel
@{
    ViewData["Title"] = "Verify Email";
}

<style>
    body {
        background-color: #0d1117;
        color: white;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    .verify-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
    }

    .verify-card {
        background: #161b22;
        padding: 40px;
        border-radius: 12px;
        border: 1px solid #2d333b;
        max-width: 420px;
        width: 100%;
        text-align: center;
        box-shadow: 0 0 12px rgba(99,102,241,0.25);
    }

        .verify-card h2 {
            margin-bottom: 15px;
        }

    .success {
        color: #22c55e;
    }

    .error {
        color: #f87171;
    }

    a {
        color: #58a6ff;
        text-decoration: none;
        display: inline-block;
        margin-top: 20px;
    }
</style>

<div class="verify-container">
    <div class="verify-card">
        @if (Model.IsSuccess)
        {
            <h2 class="success">✅ Email Verified</h2>
            <p>@Model.Message</p>
            <a href="/Login">Go to Login</a>
        }
        else
        {
            <h2 class="error">❌ Verification Failed</h2>
            <p>@Model.Message</p>
            <a href="/Register">Back to Register</a>
        }
    </div>
</div>

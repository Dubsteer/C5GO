@page
@model Website.Pages.ViewProfileModel
@{
    ViewData["Title"] = "My profile";
    Layout = "_ProfileLayout";
}

@if (TempData["ProfileMessage"] is string profileMessage)
{
    <div class="alert alert-success" role="status">@profileMessage</div>
}

<div class="profile-actions">
    <div>
        <span class="profile-label">Username</span>
        <div class="profile-username">@Model.PageUser.Username</div>
    </div>
    <div class="profile-action-buttons">
        <a asp-page="/UserProfile"
           asp-route-id="@Model.PageUser.Id"
           class="btn btn-outline-light">View public profile</a>
        <a asp-page="/EditProfile" class="btn btn-primary">Edit profile</a>
    </div>
</div>

<div class="profile-info-grid">
    <div class="profile-info-item"><span class="profile-label">First name</span><div class="profile-value">@Model.PageUser.Firstname</div></div>
    <div class="profile-info-item"><span class="profile-label">Last name</span><div class="profile-value">@Model.PageUser.Lastname</div></div>
    <div class="profile-info-item"><span class="profile-label">Email</span><div class="profile-value">@Model.PageUser.Gmail</div></div>
    <div class="profile-info-item"><span class="profile-label">Age</span><div class="profile-value">@Model.PageUser.Age</div></div>
</div>

<hr class="section-divider" />

<section aria-labelledby="playerSetupTitle">
    <h2 id="playerSetupTitle" class="profile-section-title">Player setup</h2>

    @if (Model.RequireSteam)
    {
        <div class="alert alert-info" role="alert">Connect your Steam profile before joining a tournament.</div>
    }
    else if (Model.NeedsSteamUpdate)
    {
        <div class="alert alert-warning" role="alert">Your saved Steam ID is not a valid SteamID64. Update it to activate your player profile.</div>
    }

    @if (Model.Player == null)
    {
        <div class="profile-info-item profile-steam-empty">
            <div>
                <span class="profile-label">Steam profile</span>
                <div class="profile-value">Not connected</div>
            </div>
            @if (!Model.PageUser.IsAdmin)
            {
                <a asp-page="/EditProfile" asp-fragment="steam-profile" class="btn btn-success">
                    @(Model.NeedsSteamUpdate ? "Update Steam ID" : "Add Steam ID")
                </a>
            }
        </div>
    }
    else
    {
        <div class="profile-info-item profile-steam-connected">
            <div>
                <span class="profile-label">SteamID64</span>
                <div class="profile-value">@Model.Player.SteamId</div>
                <span class="text-success fw-semibold">Player profile active</span>
                <span class="profile-steam-visibility @(Model.PageUser.ShowSteamProfile ? "is-visible" : "is-private")">
                    Public profile: @(Model.PageUser.ShowSteamProfile ? "Visible" : "Hidden")
                </span>
            </div>
            <a href="@Model.SteamProfileUrl"
               class="btn btn-outline-light"
               target="_blank"
               rel="noopener noreferrer">Open Steam profile</a>
        </div>
    }
</section>

<hr class="section-divider" />

<section aria-labelledby="matchHistoryTitle">
    <h2 id="matchHistoryTitle" class="profile-section-title">Match history</h2>
    <partial name="_PlayerMatchHistory" model="Model.MatchHistory" />
</section>

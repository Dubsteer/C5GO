@page
@model Website.Pages.ViewProfileModel
@{
    ViewData["Title"] = "My profile";
    Layout = "_ProfileLayout";
}

<div class="profile-actions">
    <div>
        <span class="profile-label">Username</span>
        <div class="profile-username">@Model.PageUser.Username</div>
    </div>
    <a asp-page="/EditProfile" class="btn btn-primary">Edit profile</a>
</div>

<div class="profile-info-grid">
    <div class="profile-info-item"><span class="profile-label">First name</span><div class="profile-value">@Model.PageUser.Firstname</div></div>
    <div class="profile-info-item"><span class="profile-label">Last name</span><div class="profile-value">@Model.PageUser.Lastname</div></div>
    <div class="profile-info-item"><span class="profile-label">Email</span><div class="profile-value">@Model.PageUser.Gmail</div></div>
    <div class="profile-info-item"><span class="profile-label">Age</span><div class="profile-value">@Model.PageUser.Age</div></div>
</div>

<hr class="section-divider" />

<section aria-labelledby="playerSetupTitle">
    <h2 id="playerSetupTitle" class="profile-section-title">Player setup</h2>

    @if (Model.RequireSteam)
    {
        <div class="alert alert-info" role="alert">Add your Steam ID before joining a tournament. You can find it on your Steam profile.</div>
    }

    @if (Model.Player == null)
    {
        <form method="post" class="profile-form-narrow">
            <label asp-for="SteamId" class="profile-label">Steam ID</label>
            <input asp-for="SteamId" class="form-control" placeholder="Enter your Steam ID" autocomplete="off" />
            <span asp-validation-for="SteamId" class="field-error"></span>
            <button type="submit" class="btn btn-success mt-2">Save and become a player</button>
        </form>
    }
    else
    {
        <div class="profile-info-item">
            <span class="profile-label">Steam ID</span>
            <div class="profile-value">@Model.Player.SteamId</div>
            <span class="text-success fw-semibold">Player profile active</span>
        </div>
    }
</section>

<hr class="section-divider" />

<section aria-labelledby="matchHistoryTitle">
    <h2 id="matchHistoryTitle" class="profile-section-title">Match history</h2>

    @if (!Model.Matches.Any())
    {
        <div class="empty-state"><strong>No matches yet</strong><span>Your tournament matches will appear here.</span></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped align-middle">
                <thead><tr><th>Tournament</th><th>Date</th><th>Your score</th></tr></thead>
                <tbody>
                    @foreach (var match in Model.Matches)
                    {
                        <tr>
                            <td>@match.TournamentId</td>
                            <td>@match.MatchDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (match.User1?.Username == Model.PageUser.Username)
                                {
                                    @match.Player1Score
                                }
                                else if (match.User2?.Username == Model.PageUser.Username)
                                {
                                    @match.Player2Score
                                }
                                else
                                {
                                    @:–
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

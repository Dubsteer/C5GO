@page
@model Website.Pages.ViewProfileModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_ProfileLayout";
}

<div>

    <!-- EDIT PROFILE BUTTON -->
    <div class="text-end mb-3">
        <a asp-page="/EditProfile" class="btn-main">
            Edit Profile ✏️
        </a>
    </div>

    <!-- USERNAME -->
    <h3 class="profile-value">@Model.PageUser.Username</h3>

    <!-- BASIC INFO -->
    <div>
        <span class="profile-label">First Name</span>
        <div class="profile-value">@Model.PageUser.Firstname</div>

        <span class="profile-label">Last Name</span>
        <div class="profile-value">@Model.PageUser.Lastname</div>

        <span class="profile-label">Email</span>
        <div class="profile-value">@Model.PageUser.Gmail</div>

        <span class="profile-label">Age</span>
        <div class="profile-value">@Model.PageUser.Age</div>
    </div>

    <hr class="section-divider" />

    <!-- PLAYER SETUP -->
    <h4 class="text-info">Player Setup</h4>

    @if (Model.Player == null)
    {
        <form method="post" class="mt-3">

            <span class="profile-label">Steam ID</span>
            <input asp-for="SteamId" class="form-control" style="max-width:300px;" placeholder="Enter your Steam ID" />
            <span asp-validation-for="SteamId" class="text-danger"></span>

            <button type="submit" class="btn-main mt-3">Save & Become Player</button>
        </form>
    }
    else
    {
        <div class="profile-value">@Model.Player.SteamId</div>
        <span style="color:lightgreen;font-weight:600;">✔ You are already a Player</span>
    }

    <hr class="section-divider" />

    <!-- MATCH HISTORY -->
    <h4 class="text-info">Match History</h4>

    @if (!Model.Matches.Any())
    {
        <p>No matches played yet.</p>
    }
    else
    {
        <table class="table table-dark table-striped mt-3">
            <thead>
                <tr>
                    <th>Tournament ID</th>
                    <th>Date</th>
                    <th>Your Score</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Matches)
                {
                    <tr>
                        <td>@m.TournamentId</td>
                        <td>@m.MatchDate.ToShortDateString()</td>
                        <td>
                            @{
                                var username = Model.PageUser.Username;

                                if (m.User1 != null && m.User1.Username == username)
                                {
                                    @m.Player1Score
                                    ;
                                }
                                else if (m.User2 != null && m.User2.Username == username)
                                {
                                    @m.Player2Score
                                    ;
                                }
                                else
                                {
                                    @:"-";
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>

@page
@model Website.Pages.ViewProfileModel
@{
    ViewData["Title"] = "Profile";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #0f2626;
        color: white;
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    .profile-container {
        max-width: 900px;
        background: #ffffff;
        color: #222;
        margin: 60px auto;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.35);
    }

    .section-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #111;
    }

    .profile-row strong {
        width: 150px;
        display: inline-block;
        color: #333;
    }

    .match-history-title {
        margin-top: 40px;
        font-size: 24px;
        font-weight: 600;
        color: #222;
    }

    .no-matches {
        color: #777;
        margin-top: 10px;
    }

    hr {
        margin-top: 25px;
        margin-bottom: 25px;
        border-color: #ddd;
    }
</style>

<div class="profile-container">
    <h1 class="section-title">👤 User Profile</h1>

    <div class="profile-row">
        <p><strong>First Name:</strong> @Model.PageUser.Firstname</p>
        <p><strong>Last Name:</strong> @Model.PageUser.Lastname</p>
        <p><strong>Username:</strong> @Model.PageUser.Username</p>
        <p><strong>Email:</strong> @Model.PageUser.Gmail</p>
        <p><strong>Age:</strong> @Model.PageUser.Age</p>
    </div>

    <hr />

    <h2 class="match-history-title">🎮 Your Match History</h2>

    @if (!Model.Matches.Any())
    {
        <p class="no-matches">No matches played yet.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Tournament</th>
                    <th>Date</th>
                    <th>Score</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Matches)
                {
                    <tr>
                        <td>@m.TournamentName</td>
                        <td>@m.Date.ToShortDateString()</td>
                        <td>@m.PlayerScore</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@page
@model Website.Pages.ViewProfileModel
@{
    ViewData["Title"] = "Profile";
}

<h2>User Profile</h2>

@if (Model.PageUser != null)
{
    <div class="profile-info">
        <p><b>First Name:</b> @Model.PageUser.Firstname</p>
        <p><b>Last Name:</b> @Model.PageUser.Lastname</p>
        <p><b>Username:</b> @Model.PageUser.Username</p>
        <p><b>Email:</b> @Model.PageUser.Gmail</p>
        <p><b>Age:</b> @Model.PageUser.Age</p>
    </div>
}
else
{
    <p>Could not load profile information.</p>
}

<hr />

@if (!Model.checkPlayer())
{
    <h3>Register as a Player</h3>

    <form method="post">
        <div class="form-group">
            <label for="SteamId">Steam ID (optional):</label>
            <input asp-for="SteamId" class="form-control" />
            <span asp-validation-for="SteamId" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Register as Player</button>
    </form>
}
else
{
    <h3>Your Match History</h3>

    @if (Model.Matches != null && Model.Matches.Count > 0)
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Opponent</th>
                    <th>Your Score</th>
                    <th>Opponent Score</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var match in Model.Matches)
                {
                    var opponentName = match.User1.Username == Model.PageUser.Username
                    ? match.User2.Username
                    : match.User1.Username;

                    var yourScore = match.User1.Username == Model.PageUser.Username
                    ? match.Player1Score
                    : match.Player2Score;

                    var opponentScore = match.User1.Username == Model.PageUser.Username
                    ? match.Player2Score
                    : match.Player1Score;

                    <tr>
                        <td>@opponentName</td>
                        <td>@yourScore</td>
                        <td>@opponentScore</td>
                        <td>@match.MatchDate.ToString("g")</td>
                        <td>@match.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No matches played yet.</p>
    }
}
